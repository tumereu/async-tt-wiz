#!/bin/sh
# Master moves only through the merge gate (scripts/merge-gate.sh): every update of refs/heads/master (a merge, a
# fast-forward, a commit on master, `git branch -f`, `git update-ref`, a push into this repository) is refused unless it
# sets master to the commit the gate has just tested (the gate passes it in ATW_MERGE_GATE_SHA). Other refs (every other
# branch, tags, HEAD) are never checked. Enabled once per clone (AGENTS.md):
#   git config core.hooksPath "$(git rev-parse --show-toplevel)/.githooks"
# Emergency override, for the coordinator only: ATW_MASTER_OVERRIDE=1 <git command>. It prints a warning.
[ "$1" = prepared ] || exit 0
status=0
while read -r old new ref; do
    [ "$ref" = refs/heads/master ] || continue
    # The ref is locked but not yet moved: an update to its current value changes nothing (git pack-refs copying it).
    [ "$new" = "$(git rev-parse -q --verify refs/heads/master 2>/dev/null)" ] && continue
    # A deletion (all zeros) moves master to no untested commit, and it is how git pack-refs drops the loose copy.
    case $new in *[!0]*) ;; *) continue ;; esac
    [ -n "${ATW_MERGE_GATE_SHA:-}" ] && [ "$new" = "$ATW_MERGE_GATE_SHA" ] && continue
    if [ "${ATW_MASTER_OVERRIDE:-}" = 1 ]; then
        cat >&2 <<EOF
##############################################################################
!!! ATW_MASTER_OVERRIDE=1: master moves to $new WITHOUT THE MERGE GATE.
!!! Nothing tested this commit. Run scripts/full-verify.sh on master soon.
##############################################################################
EOF
        continue
    fi
    cat >&2 <<'EOF'
Refused: master moves only through the merge gate, which tests the merge first:
    scripts/merge-gate.sh <branch>
Commit on a branch and gate it (docs-only changes take about a minute). Emergency only: ATW_MASTER_OVERRIDE=1.
A refused merge or fast-forward leaves its changes in this checkout: undo them with `git merge --abort` (a merge) or
`git reset --merge` (a fast-forward); both keep your own uncommitted changes. A refused commit leaves them staged.
EOF
    status=1
done
exit $status
