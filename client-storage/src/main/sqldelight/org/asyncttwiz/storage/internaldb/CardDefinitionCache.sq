-- Arcanum card definitions parsed on the device from a game's card data (CardDefinitions), keyed by the card data's
-- definition digest and the parser version. Public derived data like public_cache, never account data.
-- definition_json is null when the card's printed values could not be read; problem then says why.
CREATE TABLE card_definition_cache (
  definition_digest TEXT NOT NULL,
  parser_version INTEGER NOT NULL,
  definition_json TEXT,
  manual_abilities INTEGER NOT NULL CHECK (manual_abilities >= 0),
  problem TEXT,
  PRIMARY KEY (definition_digest, parser_version),
  CHECK ((definition_json IS NULL) != (problem IS NULL))
);

selectDefinitions:
SELECT definition_digest, definition_json, manual_abilities, problem FROM card_definition_cache
WHERE parser_version = ? AND definition_digest IN ?;

putDefinition:
INSERT OR REPLACE INTO card_definition_cache(definition_digest, parser_version, definition_json, manual_abilities, problem)
VALUES (?, ?, ?, ?, ?);

deleteOtherParserVersions:
DELETE FROM card_definition_cache WHERE parser_version != ?;
