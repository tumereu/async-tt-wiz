-- Single version (owner 2026-11-08): the migration to version 6 adds this row once, so every phone downloads its card
-- records again once in that update; the app clears them while it is here (ClientStorage.redownloadCatalog). New
-- installations never have it.
CREATE TABLE catalog_redownload (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1)
);

