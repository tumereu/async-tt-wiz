CREATE TABLE personal_state (
  scope_id TEXT NOT NULL,
  state_key TEXT NOT NULL,
  payload_json TEXT NOT NULL,
  payload_version INTEGER NOT NULL DEFAULT 1,
  PRIMARY KEY (scope_id, state_key)
);

selectState:
SELECT payload_version, payload_json FROM personal_state WHERE scope_id = ? AND state_key = ?;

putState:
INSERT OR REPLACE INTO personal_state(scope_id, state_key, payload_version, payload_json)
VALUES (?, ?, ?, ?);

removeState:
DELETE FROM personal_state WHERE scope_id = ? AND state_key = ?;
