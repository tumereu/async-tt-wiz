# Copy to deploy/.env; never put credential values here.
PUBLIC_BASE_URL=https://tabletop.example.com
# Defaults to PUBLIC_BASE_URL; match the APK's reset origin if overridden.
# RESET_BASE_URL=https://tabletop.example.com
API_PORT=8080

# Relative secret paths are resolved against deploy/, not the shell's directory.
DB_PASSWORD_PATH=./secrets/db-password
RESET_MAIL_KEY_PATH=./secrets/reset-mail-key

# Optional: configure a real SMTP relay to enable password-reset email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=tabletop@example.com
# SMTP_TLS=starttls
# For authentication also add -f deploy/compose.smtp.yml to every compose command.
# SMTP_USERNAME_PATH=./secrets/smtp-username
# SMTP_PASSWORD_PATH=./secrets/smtp-password
