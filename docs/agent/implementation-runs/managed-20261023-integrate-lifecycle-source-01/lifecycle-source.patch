+            assertNull(f.lobby.setupCancellation.confirmation); assertNull(f.lobby.setupCancellation.context)
+            assertTrue(f.commands().isEmpty())
+            if (play != null) assertEquals(play, f.lobby.state.play)
+        }
+    }
