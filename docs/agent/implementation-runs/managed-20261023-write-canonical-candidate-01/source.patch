+  "output": "Source-bound limitations; not executed product assertions\n\nprotocol/src/commonMain/kotlin/org/asyncttwiz/protocol/HistoryGrouping.kt sha256=cd28b94dadb317bd5566c53a3507c1f7aa7d2dba4121a9eef021a6acd49c4380\n36: object HistoryGrouping {\n37:     /** Exhaustive mapping of the actual implemented catalog. New tools must add their exact mapping here.\n38:      * Zone identity comes from accepted containers, not labels, card text, timers or invocation proximity. */\n39:     fun classify(action: PlayAction, containers: List<PlayContainer> = emptyList(),\n40:         transition: GameplayTransition? = null): HistorySemantic = when (action) {\n41:         is PlayAction.SetTapped -> HistorySemantic(HistorySignificance.ORIENTATION, \"rotate_90_degrees_cw\")\n42:         is PlayAction.SetLife, is PlayAction.AdjustLife -> HistorySemantic(HistorySignificance.LIFE_PLAYER_COUNTER_EDIT, \"favorite\")\n43:         is PlayAction.SetPlayerCounter, is PlayAction.AdjustPlayerCounter ->\n44:             HistorySemantic(HistorySignificance.LIFE_PLAYER_COUNTER_EDIT, \"exposure_plus_1\")\n45:         PlayAction.EndTurn -> HistorySemantic(HistorySignificance.TURN_TRANSITION, \"outlined_flag\")\n46:         PlayAction.NextStep -> HistorySemantic(if (transition?.fields?.any { it.field == GameplayField.TURN_PLAYER } == true)\n47:             HistorySignificance.TURN_TRANSITION else HistorySignificance.PHASE_STEP_TRACKING, \"outlined_flag\")\n48:         is PlayAction.ChooseStep -> HistorySemantic(HistorySignificance.PHASE_STEP_TRACKING, \"outlined_flag\")\n49:         is PlayAction.RollDie -> HistorySemantic(HistorySignificance.DIE_COIN_RUN, \"casino\")\n\nprotocol/src/commonMain/kotlin/org/asyncttwiz/protocol/TokensAndLinks.kt sha256=d7e5ad60a76f1182407f55e35e79b938d22c196df9c8bb40eaa45cc037dfa676\n5: /** Persistent visual relationships, not source relationships or event-scoped pings. */\n6: @Serializable enum class LinkEndpointKind { CARD, PLAYER }\n7: @Serializable data class LinkEndpoint(val kind: LinkEndpointKind, val id: String)\n8: @Serializable data class PlayLink(val id: String, val first: LinkEndpoint, val second: LinkEndpoint)\n9: @Serializable data class LinkChange(val from: PlayLink?, val to: PlayLink?)\n\nprotocol/src/commonMain/kotlin/org/asyncttwiz/protocol/CombatAndStack.kt sha256=cb3474f0f73379493f5b759ad0098aa99986b908da94f0344b5242872845f5c9\n15: /** Only disappearance retains card data. Live effects never cache fields or a creation-time snapshot. */\n16: @Serializable data class StackEffect(val id: String, val sourceId: String, val frozen: PlayCard? = null)\n17: /** D-120 projection-to-projection links, not the source relationship and not selection. */\n18: @Serializable data class ProjectionLink(val id: String, val first: String, val second: String)\n\nclient-storage/src/main/kotlin/org/asyncttwiz/storage/CatalogDatabase.kt sha256=546f4eb6a0e8c77c5114ce7bbecbce7834e3c062b0d6b8b2ce6485d10df9ff5f\n29:     @Synchronized fun metadata(): CatalogMetadata? = activeFile()?.let { file ->\n30:         CatalogIndex(openDriver(file)).use { it.metadata() }\n31:     }\n32: \n33:     /** Exact normalized name, optionally exact set/collector number. Ambiguity is returned, not guessed. */\n34:     @Synchronized fun find(name: String, set: String? = null, number: String? = null, limit: Int = 100): List<CatalogPrinting> =\n35:         activeFile()?.let { file -> CatalogIndex(openDriver(file)).use { it.find(name, set, number, limit) } }.orEmpty()\n36: \n37:     @Synchronized fun printing(id: String): CatalogPrinting? = activeFile()?.let { file ->\n38:         CatalogIndex(openDriver(file)).use { it.printing(id) }\n39:     }\n\nandroidApp/src/main/kotlin/org/asyncttwiz/android/LobbyController.kt sha256=336ad205e1cbb2ff28b87b9f27cb173e9c7d08a89c5c08a235291f1410cacee2\n13: data class LobbyState(val contacts: List<AccountIdentity> = emptyList(), val query: String = \"\",\n14:     val results: List<AccountIdentity> = emptyList(), val searched: Boolean = false, val searching: Boolean = false,\n15:     val searchError: String? = null, val games: List<GameSummary> = emptyList(), val invitations: List<GameSummary> = emptyList(),\n16:     val selected: String? = null, val detail: GameSummary? = null, val draft: GameNameDraft? = null,\n17:     val busy: Boolean = false, val mutating: Boolean = false, val uncertain: Boolean = false,\n18:     val error: String? = null, val loaded: Boolean = false, val connectionMessage: String? = null,\n19:     val connectedGames: Set<String> = emptySet(), val pendingGames: Set<String> = emptySet(),\n20:     val picker: DeckPickerState? = null, val acceptedPreparation: LobbyPreparation? = null,\n21:     val preparation: LobbyPreparation? = null, val queuedTransferCards: Long = 0,\n22:     val preparing: Boolean = false, val transferFeedback: TransferFeedback? = null, val play: PlayState? = null,\n23:     val acceptedPlay: PlayState? = null)\n\nandroidApp/src/main/kotlin/org/asyncttwiz/android/GameSession.kt sha256=751ff11a997eb83a9d5fb2f7044853d9a9ccd8abf7e989b5a6f2b9a563b1dd35\n130:     fun gameplay(game: GameSummary, actor: String, action: PlayAction, invocationId: String? = null): Boolean {\n131:         checkAccount()\n132:         val current = summary(game)\n133:         if (closed || !ready(game.id) || credential() != token || pending.size >= 256 ||\n134:             current.lifecycle != GameLifecycle.ACTIVE || current.playId == null ||\n135:             (account != null && account != actor)) return false\n136:         val replica = plays[game.id] ?: return false\n137:         if (replica.pendingIds.size >= 256 || replica.accepted?.id != current.playId) return false\n138:         val stream = streams.getValue(game.id)\n139:         val command = GameCommand(UUID.randomUUID().toString(), GameScope(game.id, playId = current.playId),\n140:             GameAction.Play(action), stream.id, stream.generation!!, invocationId = invocationId)\n141:         if (!replica.predict(command, actor)) return false\n142:         pending[command.requestId] = command\n143:         error = null; flush(); statusChanged(); return true\n"
