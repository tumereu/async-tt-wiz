diff --git a/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/SelectiveUndo.kt b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/SelectiveUndo.kt
new file mode 100644
index 0000000..e5a9d81
--- /dev/null
+++ b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/SelectiveUndo.kt
@@ -0,0 +1,99 @@
+package org.asyncttwiz.protocol
+
+/** Pure processing-time engine. The caller owns admission order, deduplication, lifecycle and atomic SQL.
+ * Never call this again for a completed request: recover its original inbox result instead.
+ */
+object SelectiveUndo {
+    fun change(tree: GameplayTree, actor: String, command: GameCommand,
+        limits: SelectiveUndoLimits = SelectiveUndoLimits()): GameplayTreeChange {
+        if (!GameWire.valid(command) || command.action !in listOf(GameAction.Undo, GameAction.Redo))
+            return GameplayTreeChange(reason = "invalidInput")
+        if (command.scope.gameId != tree.initial.gameId || command.scope.playId != tree.initial.id)
+            return GameplayTreeChange(reason = "inapplicable")
+        if (actor !in tree.initial.board.players.map { it.accountId }) return GameplayTreeChange(reason = "accessDenied")
+        return boundedHistory(limits) { work ->
+            tree.checkMetadata(work)
+            if (command.action == GameAction.Undo) undo(tree, actor, limits, work) else redo(tree, actor, limits, work)
+        } ?: GameplayTreeChange(reason = "workLimit")
+    }
+
+    private fun children(tree: GameplayTree): Map<String, List<GameplayMutation>> = tree.nodes.values.groupBy { it.parentId }
+
+    /** Complete retained linear future, not just the active path. A fork fails before any edit. */
+    private fun suffix(start: GameplayMutation?, children: Map<String, List<GameplayMutation>>,
+        limit: Int): List<GameplayMutation>? {
+        val result = mutableListOf<GameplayMutation>()
+        val seen = mutableSetOf<String>()
+        var node = start
+        while (node != null) {
+            if (result.size >= limit || !seen.add(node.id)) return null
+            result.add(node)
+            val next = children[node.id].orEmpty()
+            if (next.size > 1) return null
+            node = next.singleOrNull()
+        }
+        return result
+    }
+
+    private fun undo(tree: GameplayTree, actor: String, limits: SelectiveUndoLimits, work: HistoryWork): GameplayTreeChange {
+        val path = tree.path(tree.currentNodeId, work) ?: return GameplayTreeChange(reason = "missingReference")
+        val target = path.lastOrNull { it.author == actor } ?: return GameplayTreeChange(reason = "noCandidate")
+        if (target.revealsInformation) return GameplayTreeChange(reason = "revealingTarget", targetId = target.id)
+        val children = children(tree)
+        if (children[target.id].orEmpty().size > 1) return GameplayTreeChange(reason = "forkBoundary", targetId = target.id)
+        val later = suffix(children[target.id]?.singleOrNull(), children, limits.suffixNodes)
+            ?: return GameplayTreeChange(reason = "suffixUnavailable", targetId = target.id)
+        var state = tree.materialize(target.parentId, work) ?: return GameplayTreeChange(reason = "historyUnavailable")
+        if (!tree.referencesMatch(target, work) || tree.replay(state, target, work) == null)
+            return GameplayTreeChange(reason = "targetTransitionBlocked", targetId = target.id)
+        val successor = later.firstOrNull()
+        val nodes = (tree.nodes - target.id).let { nodes ->
+            if (successor == null) nodes else nodes + (successor.id to successor.copy(parentId = target.parentId))
+        }
+        val entry = GameplayRedoEntry(target, successor?.id,
+            children[target.parentId].orEmpty().filter { it.id != target.id }.map { it.id }.toSet())
+        val candidate = tree.copy(nodes = nodes,
+            currentNodeId = if (tree.currentNodeId == target.id) target.parentId else tree.currentNodeId,
+            redoByAccount = tree.redoByAccount + (actor to (tree.redoByAccount[actor].orEmpty() + entry)),
+            removedParents = tree.removedParents + (target.id to target.parentId))
+        for (node in later) {
+            if (!candidate.referencesMatch(node, work)) return GameplayTreeChange(reason = "referenceBlocked", targetId = target.id)
+            state = candidate.replay(state, nodes.getValue(node.id), work)
+                ?: return GameplayTreeChange(reason = "replayBlocked", targetId = target.id)
+        }
+        return GameplayTreeChange(candidate, targetId = target.id)
+    }
+
+    private fun redo(tree: GameplayTree, actor: String, limits: SelectiveUndoLimits, work: HistoryWork): GameplayTreeChange {
+        val queue = tree.redoByAccount[actor].orEmpty()
+        val entry = queue.lastOrNull() ?: return GameplayTreeChange(reason = "noCandidate")
+        val target = entry.mutation
+        val path = tree.path(tree.currentNodeId, work) ?: return GameplayTreeChange(reason = "missingReference")
+        if (target.id in tree.nodes || (target.parentId != tree.initial.root.id && path.none { it.id == target.parentId }))
+            return GameplayTreeChange(reason = "missingAnchor", targetId = target.id)
+        val children = children(tree)
+        val continuation = children[target.parentId].orEmpty().filter { it.id !in entry.otherChildIds }
+        if (continuation.size > 1) return GameplayTreeChange(reason = "forkBoundary", targetId = target.id)
+        val successor = continuation.singleOrNull()
+        if (entry.successorId != null && successor?.id != entry.successorId)
+            return GameplayTreeChange(reason = "missingAnchor", targetId = target.id)
+        var state = tree.materialize(target.parentId, work) ?: return GameplayTreeChange(reason = "historyUnavailable")
+        if (!tree.referencesMatch(target, work)) return GameplayTreeChange(reason = "referenceBlocked", targetId = target.id)
+        // Exact target transition FIRST, even if there is no suffix. No fresh arithmetic/defaults/targets.
+        state = tree.replay(state, target, work) ?: return GameplayTreeChange(reason = "targetTransitionBlocked", targetId = target.id)
+        val later = suffix(successor, children, limits.suffixNodes)
+            ?: return GameplayTreeChange(reason = "suffixUnavailable", targetId = target.id)
+        var nodes = tree.nodes + (target.id to target)
+        if (successor != null) nodes = nodes + (successor.id to successor.copy(parentId = target.id))
+        val candidate = tree.copy(nodes = nodes,
+            currentNodeId = if (tree.currentNodeId == target.parentId) target.id else tree.currentNodeId,
+            redoByAccount = if (queue.size == 1) tree.redoByAccount - actor else tree.redoByAccount + (actor to queue.dropLast(1)),
+            removedParents = tree.removedParents - target.id)
+        for (node in later) {
+            if (!candidate.referencesMatch(node, work)) return GameplayTreeChange(reason = "referenceBlocked", targetId = target.id)
+            state = candidate.replay(state, nodes.getValue(node.id), work)
+                ?: return GameplayTreeChange(reason = "replayBlocked", targetId = target.id)
+        }
+        return GameplayTreeChange(candidate, targetId = target.id)
+    }
+}
diff --git a/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/TableActions.kt b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/TableActions.kt
new file mode 100644
index 0000000..df7b6d1
--- /dev/null
+++ b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/TableActions.kt
@@ -0,0 +1,107 @@
+package org.asyncttwiz.protocol
+
+import kotlinx.serialization.Serializable
+
+/** Fixed manual positions. Main phases have one position, not an invented additional step. */
+@Serializable enum class TurnPosition(val phase: String, val step: String, val label: String, val glyph: String) {
+    UNTAP("BEGINNING", "UNTAP", "Untap", "↶"),
+    UPKEEP("BEGINNING", "UPKEEP", "Upkeep", "⌛"),
+    DRAW("BEGINNING", "DRAW", "Draw", "↓"),
+    PRECOMBAT_MAIN("PRECOMBAT_MAIN", "MAIN", "Precombat main", "①"),
+    BEGIN_COMBAT("COMBAT", "BEGIN_COMBAT", "Beginning of combat", "⚑"),
+    DECLARE_ATTACKERS("COMBAT", "DECLARE_ATTACKERS", "Declare attackers", "⚔"),
+    DECLARE_BLOCKERS("COMBAT", "DECLARE_BLOCKERS", "Declare blockers", "⛨"),
+    COMBAT_DAMAGE("COMBAT", "COMBAT_DAMAGE", "Combat damage", "♨"),
+    END_COMBAT("COMBAT", "END_COMBAT", "End of combat", "⚐"),
+    POSTCOMBAT_MAIN("POSTCOMBAT_MAIN", "MAIN", "Postcombat main", "②"),
+    END_STEP("ENDING", "END_STEP", "End step", "☾"),
+    CLEANUP("ENDING", "CLEANUP", "Cleanup", "◇");
+
+    companion object {
+        fun of(turn: TurnState) = entries.singleOrNull { it.phase == turn.phase && it.step == turn.step }
+    }
+}
+
+@Serializable enum class CoinFace { HEADS, TAILS }
+
+/** Extensions of the sole GameplayRules processor. No entropy, queue or rules engine lives here. */
+object TableActions {
+    fun numeric(value: String) = DeckValidation.text(value) && value.matches(Regex("[+-]?[0-9]+"))
+
+    /** Unicode 15.1 White_Space, not platform-dependent trim or expression parsing. */
+    fun trimText(value: String) = value.trim { it.code in 9..13 || it.code in listOf(32, 133, 160, 5760,
+        8232, 8233, 8239, 8287, 12288) || it.code in 8192..8202 }
+
+    /** Shared scalar arithmetic; exact signed decimal strings, bounded only by the existing text limit. */
+    fun addNumber(from: String, delta: String): String? {
+        if (!numeric(from) || !numeric(delta)) return null
+        return GameplayNumbers.add(from, delta).takeIf(DeckValidation::text)
+    }
+
+    internal fun change(state: PlayState, actor: String, command: GameCommand, action: PlayAction): GameplayChange {
+        fun reject(reason: String) = GameplayChange(reason = reason)
+        val board = state.board
+        if (action is PlayAction.RollDie || action is PlayAction.FlipCoin) {
+            val result = when (action) {
+                is PlayAction.RollDie -> GameplayRandomResult(RandomTool.DIE, action.value.toString(), action.sides)
+                is PlayAction.FlipCoin -> GameplayRandomResult(RandomTool.COIN, action.value.name)
+                else -> error("unreachable")
+            }
+            // Even a repeated result is a distinct information-gaining event; no board marker is added.
+            return GameplayRules.record(state, actor, command, board, GameplayTransition(random = result))
+        }
+        if (action is PlayAction.SetPlayerCounter || action is PlayAction.AdjustPlayerCounter) {
+            val account = when (action) {
+                is PlayAction.SetPlayerCounter -> action.accountId
+                is PlayAction.AdjustPlayerCounter -> action.accountId
+                else -> error("unreachable")
+            }
+            val color = when (action) {
+                is PlayAction.SetPlayerCounter -> action.color
+                is PlayAction.AdjustPlayerCounter -> action.color
+                else -> error("unreachable")
+            }
+            val player = board.players.singleOrNull { it.accountId == account } ?: return reject("missingReference")
+            val from = player.counters[color]
+            val to = if (action is PlayAction.SetPlayerCounter) trimText(action.value).takeIf { it.isNotEmpty() } else {
+                val number = from ?: "0"
+                if (!numeric(number)) return reject("inapplicable")
+                val delta = (action as PlayAction.AdjustPlayerCounter).delta
+                if (delta.removePrefix("+").removePrefix("-").all { it == '0' }) return GameplayChange(state)
+                addNumber(number, delta) ?: return reject("invalidInput")
+            }
+            if (from == to) return GameplayChange(state)
+            val counters = if (to == null) player.counters - color else player.counters + (color to to)
+            return GameplayRules.record(state, actor, command,
+                board.copy(players = board.players.map { if (it.accountId == account) it.copy(counters = counters) else it }),
+                GameplayTransition(listOf(GameplayFieldChange(account, GameplayField.COUNTER, from, to, color))))
+        }
+        val from = board.turn
+        val position = TurnPosition.of(from) ?: return reject("inapplicable")
+        val nextTurn = action == PlayAction.EndTurn || (action == PlayAction.NextStep && position == TurnPosition.CLEANUP)
+        val to = if (nextTurn) {
+            val other = board.players.singleOrNull { it.accountId != from.accountId } ?: return reject("inapplicable")
+            if (board.players.none { it.accountId == from.accountId }) return reject("inapplicable")
+            if (!from.number.matches(Regex("[1-9][0-9]*"))) return reject("inapplicable")
+            val number = addNumber(from.number, "1") ?: return reject("invalidInput")
+            TurnState(other.accountId, number)
+        } else {
+            val chosen = when (action) {
+                PlayAction.NextStep -> TurnPosition.entries[position.ordinal + 1]
+                is PlayAction.ChooseStep -> action.position
+                else -> return reject("invalidInput")
+            }
+            from.copy(phase = chosen.phase, step = chosen.step)
+        }
+        if (from == to) return GameplayChange(state)
+        // Direct selection/ordinary advancement only depend on phase and step, not unchanged values.
+        val fields = mutableListOf(
+            GameplayFieldChange(state.id, GameplayField.PHASE, from.phase, to.phase),
+            GameplayFieldChange(state.id, GameplayField.STEP, from.step, to.step))
+        if (nextTurn) {
+            fields += GameplayFieldChange(state.id, GameplayField.TURN_PLAYER, from.accountId, to.accountId)
+            fields += GameplayFieldChange(state.id, GameplayField.TURN_NUMBER, from.number, to.number)
+        }
+        return GameplayRules.record(state, actor, command, board.copy(turn = to), GameplayTransition(fields))
+    }
+}
diff --git a/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/TokensAndLinks.kt b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/TokensAndLinks.kt
new file mode 100644
index 0000000..be23aec
--- /dev/null
+++ b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/TokensAndLinks.kt
@@ -0,0 +1,217 @@
+package org.asyncttwiz.protocol
+
+import kotlinx.serialization.Serializable
+
+/** Persistent visual relationships, not source relationships or event-scoped pings. */
+@Serializable enum class LinkEndpointKind { CARD, PLAYER }
+@Serializable data class LinkEndpoint(val kind: LinkEndpointKind, val id: String)
+@Serializable data class PlayLink(val id: String, val first: LinkEndpoint, val second: LinkEndpoint)
+@Serializable data class LinkChange(val from: PlayLink?, val to: PlayLink?)
+/** Full object data is relevant to creation/destruction only, never an ordinary field-edit lock. */
+@Serializable data class TokenPresence(val card: PlayCard, val location: CardLocation)
+@Serializable data class TokenChange(val from: TokenPresence?, val to: TokenPresence?)
+@Serializable data class TokenMoveRead(val destinationId: String, val destinationZone: PlayZone)
+/** Clone does not read the source's owner, token flag or location. Definition retains face defaults. */
+@Serializable data class CloneRead(val sourceId: String, val definition: SubmittedDefinition,
+    val faceId: String, val covered: Boolean, val tapped: Boolean, val corner: String,
+    val counters: Map<CounterColor, String>, val note: String)
+
+object TokenCatalog {
+    val blank: SubmittedDefinition = CardDefinition("Blank", listOf(DefinitionFace(
+        "548c71f3-20cd-53f0-b9b0-737030a14f51", "Blank")), provider = "async-tt-wiz",
+        sourceVersion = "blank-v1", token = true).let { SubmittedDefinition(DeckJson.digest(it), it) }
+}
+
+/** Extension of GameplayRules, not a second state processor. All outputs use the existing record path. */
+object TokenLinkRules {
+    fun validDefinition(value: SubmittedDefinition) = DeckValidation.definition(value.definition) &&
+        value.definition.token && value.digest == DeckJson.digest(value.definition)
+
+    fun exists(board: BoardState, endpoint: LinkEndpoint): Boolean = when (endpoint.kind) {
+        LinkEndpointKind.CARD -> board.cards.any { it.id == endpoint.id }
+        LinkEndpointKind.PLAYER -> board.players.any { it.accountId == endpoint.id }
+    }
+
+    fun pair(first: LinkEndpoint, second: LinkEndpoint): Pair<LinkEndpoint, LinkEndpoint> =
+        if ("${first.kind}/${first.id}" <= "${second.kind}/${second.id}") first to second else second to first
+
+    internal fun change(state: PlayState, actor: String, command: GameCommand, action: PlayAction): GameplayChange {
+        val board = state.board
+        fun reject(reason: String) = GameplayChange(reason = reason)
+        when (action) {
+            is PlayAction.CreateToken, is PlayAction.CloneToken -> {
+                val read = if (action is PlayAction.CloneToken) {
+                    val card = board.cards.singleOrNull { it.id == action.cardId } ?: return reject("missingReference")
+                    val definition = state.definitions.singleOrNull { it.digest == card.definition }
+                        ?: return reject("missingReference")
+                    if (definition.definition.faces.none { it.faceId == card.faceId }) return reject("missingReference")
+                    CloneRead(card.id, definition, card.faceId, card.covered, card.tapped, card.corner, card.counters, card.note)
+                } else null
+                val definition = read?.definition ?: (action as PlayAction.CreateToken).definition
+                val retained = state.definitions.singleOrNull { it.digest == definition.digest }
+                if (retained != null && retained != definition) return reject("invalidInput")
+                val container = board.containers.singleOrNull { it.zone == PlayZone.BATTLEFIELD && it.accountId == actor }
+                    ?: return reject("missingReference")
+                val tokenId = CommandIds.uuidV5(command.requestId, "token/0")
+                val pileId = CommandIds.uuidV5(command.requestId, "pile/0")
+                if (occupied(board, tokenId) || occupied(board, pileId)) return reject("inapplicable")
+                // A fresh free-standing logical cell. Never insert in an existing pile or displace cards.
+                val positions = board.cards.filter { it.containerId == container.id }.mapNotNull { it.placement?.position }.toSet()
+                var x = 0
+                while (BoardPosition(x, 0) in positions) x++
+                val face = definition.definition.faces.first()
+                val token = PlayCard(tokenId, definition.digest, actor, container.id, read?.faceId ?: face.faceId,
+                    covered = read?.covered ?: false, tapped = read?.tapped ?: false, corner = read?.corner ?: face.corner,
+                    counters = read?.counters ?: emptyMap(), note = read?.note ?: "", token = true,
+                    placement = PlayPlacement(BoardPosition(x, 0), pileId))
+                val presence = TokenPresence(token, CardLocation(container.id, token.placement))
+                val next = board.copy(cards = (board.cards + token).sortedBy { it.id }, containers = board.containers.map {
+                    if (it.id == container.id) it.copy(cards = (it.cards + token.id).sorted()) else it
+                })
+                return GameplayRules.record(state.copy(definitions = (state.definitions + definition).distinctBy { it.digest }.sortedBy { it.digest }),
+                    actor, command, next, GameplayTransition(tokens = listOf(TokenChange(null, presence)), cloneRead = read))
+            }
+            is PlayAction.RemoveToken -> {
+                val card = board.cards.singleOrNull { it.id == action.cardId } ?: return reject("missingReference")
+                if (!card.token) return reject("inapplicable")
+                return remove(state, actor, command, card)
+            }
+            is PlayAction.Link -> {
+                if (!exists(board, action.first) || !exists(board, action.second)) return reject("missingReference")
+                if (action.first == action.second) return reject("inapplicable")
+                val (first, second) = pair(action.first, action.second)
+                if (board.links.any { pair(it.first, it.second) == (first to second) }) return GameplayChange(state)
+                val id = CommandIds.uuidV5(command.requestId, "link/0")
+                if (occupied(board, id)) return reject("inapplicable")
+                val link = PlayLink(id, first, second)
+                return GameplayRules.record(state, actor, command, board.copy(links = (board.links + link).sortedBy { it.id }),
+                    GameplayTransition(links = listOf(LinkChange(null, link))))
+            }
+            is PlayAction.RemoveLink -> {
+                val link = board.links.singleOrNull { it.id == action.linkId } ?: return GameplayChange(state)
+                return GameplayRules.record(state, actor, command, board.copy(links = board.links - link),
+                    GameplayTransition(links = listOf(LinkChange(link, null))))
+            }
+            is PlayAction.LinkProjections -> {
+                if (!CombatStackRules.exists(board, action.first) || !CombatStackRules.exists(board, action.second))
+                    return reject("missingReference")
+                val (first, second) = CombatStackRules.projectionPair(action.first.occurrenceId, action.second.occurrenceId)
+                if (first == second) return reject("inapplicable")
+                if (board.projectionLinks.any { CombatStackRules.projectionPair(it.first, it.second) == (first to second) })
+                    return GameplayChange(state)
+                val id = CommandIds.uuidV5(command.requestId, "projection-link/0")
+                if (occupied(board, id)) return reject("inapplicable")
+                val link = ProjectionLink(id, first, second)
+                return GameplayRules.record(state, actor, command,
+                    board.copy(projectionLinks = (board.projectionLinks + link).sortedBy { it.id }), GameplayTransition())
+            }
+            is PlayAction.RemoveProjectionLink -> {
+                val link = board.projectionLinks.singleOrNull { it.id == action.linkId } ?: return GameplayChange(state)
+                return GameplayRules.record(state, actor, command,
+                    board.copy(projectionLinks = board.projectionLinks - link), GameplayTransition())
+            }
+            else -> error("Not a token/link action")
+        }
+    }
+
+    internal fun occupied(board: BoardState, id: String) = board.cards.any { it.id == id || it.placement?.pileId == id } ||
+        board.containers.any { it.id == id } || board.players.any { it.accountId == id } || board.links.any { it.id == id } ||
+        board.projectionLinks.any { it.id == id } || id in CombatStackRules.projectionIds(board) ||
+        board.combat?.id == id || board.combat?.pairs.orEmpty().any { it.id == id }
+
+    private fun location(board: BoardState, card: PlayCard): CardLocation? {
+        val container = board.containers.singleOrNull { it.id == card.containerId } ?: return null
+        val index = container.cards.indexOf(card.id)
+        if (index < 0) return null
+        val ordered = container.zone in setOf(PlayZone.LIBRARY, PlayZone.HAND, PlayZone.STACK)
+        return CardLocation(container.id, card.placement,
+            if (ordered) container.cards.getOrNull(index - 1) else null,
+            if (ordered) container.cards.getOrNull(index + 1) else null)
+    }
+
+    private fun remove(state: PlayState, actor: String, command: GameCommand, card: PlayCard,
+        moveRead: TokenMoveRead? = null): GameplayChange {
+        val location = location(state.board, card) ?: return GameplayChange(reason = "missingReference")
+        val endpoint = LinkEndpoint(LinkEndpointKind.CARD, card.id)
+        val links = state.board.links.filter { it.first == endpoint || it.second == endpoint }
+        return GameplayRules.record(state, actor, command, state.board.copy(cards = state.board.cards - card,
+            containers = state.board.containers.map { it.copy(cards = it.cards - card.id) }, links = state.board.links - links.toSet()),
+            GameplayTransition(tokens = listOf(TokenChange(TokenPresence(card, location), null)),
+                links = links.sortedBy { it.id }.map { LinkChange(it, null) }, tokenMoveRead = moveRead))
+    }
+
+    /** I13 calls this for all move routes before ordinary destination resets. Null means ordinary movement. */
+    fun disappearForMove(state: PlayState, actor: String, command: GameCommand, action: PlayAction.MoveCard): GameplayChange? {
+        val card = state.board.cards.singleOrNull { it.id == action.cardId } ?: return null
+        val destination = state.board.containers.singleOrNull { it.id == action.destination.containerId } ?: return null
+        if (!card.token || destination.zone !in setOf(PlayZone.LIBRARY, PlayZone.GRAVEYARD, PlayZone.EXILE)) return null
+        if (card.containerId != action.source.containerId || card.placement != action.source.placement)
+            return GameplayChange(reason = "inapplicable")
+        val source = state.board.containers.singleOrNull { it.id == card.containerId } ?: return GameplayChange(reason = "missingReference")
+        if (card.id !in source.cards || (action.source.edge == MoveSourceEdge.TOP && source.cards.firstOrNull() != card.id) ||
+            (action.source.edge == MoveSourceEdge.BOTTOM && source.cards.lastOrNull() != card.id))
+            return GameplayChange(reason = "inapplicable")
+        val dest = action.destination
+        if (dest.position != null || dest.pileId != null ||
+            (destination.zone == PlayZone.LIBRARY && dest.insertion !in setOf(MoveInsertion.TOP, MoveInsertion.BOTTOM, MoveInsertion.GAP)) ||
+            (destination.zone != PlayZone.LIBRARY && dest.insertion != MoveInsertion.UNORDERED) ||
+            (dest.insertion != MoveInsertion.GAP && (dest.afterId != null || dest.beforeId != null)))
+            return GameplayChange(reason = "inapplicable")
+        if (dest.insertion == MoveInsertion.GAP) {
+            if (card.id in dest.pendingIds || dest.afterId in dest.pendingIds || dest.beforeId in dest.pendingIds)
+                return GameplayChange(reason = "inapplicable")
+            val remaining = destination.cards.filterNot { it == card.id || it in dest.pendingIds }
+            val index = if (dest.afterId == null) 0 else remaining.indexOf(dest.afterId).takeIf { it >= 0 }?.plus(1)
+                ?: return GameplayChange(reason = "inapplicable")
+            if (remaining.getOrNull(index) != dest.beforeId) return GameplayChange(reason = "inapplicable")
+        }
+        return remove(state, actor, command, card, TokenMoveRead(destination.id, destination.zone))
+    }
+
+    internal fun inverse(board: BoardState, transition: GameplayTransition): BoardState? {
+        if (transition.fields.isNotEmpty() || transition.movement != null ||
+            transition.libraryOrder != null || transition.contents != null || transition.random != null ||
+            transition.annotation != null || transition.combatStack != null ||
+            transition.reads.isNotEmpty() || transition.disclosures.isNotEmpty() ||
+            (transition.tokens.isEmpty() && transition.links.isEmpty())) return null
+        var next = board
+        // Remove created links first; restored incident links are added only after their endpoints.
+        for (change in transition.links) if (change.to != null) {
+            if (next.links.singleOrNull { it.id == change.to.id } != change.to) return null
+            next = next.copy(links = next.links - change.to)
+        }
+        for (change in transition.tokens.asReversed()) {
+            change.to?.let { presence ->
+                if (next.cards.singleOrNull { it.id == presence.card.id } != presence.card || location(next, presence.card) != presence.location ||
+                    next.links.any { it.first == LinkEndpoint(LinkEndpointKind.CARD, presence.card.id) ||
+                        it.second == LinkEndpoint(LinkEndpointKind.CARD, presence.card.id) }) return null
+                next = next.copy(cards = next.cards - presence.card,
+                    containers = next.containers.map { it.copy(cards = it.cards - presence.card.id) })
+            }
+            change.from?.let { presence ->
+                val card = presence.card
+                if (occupied(next, card.id)) return null
+                val container = next.containers.singleOrNull { it.id == presence.location.containerId } ?: return null
+                val loc = presence.location
+                if (card.placement != loc.placement || card.containerId != container.id || !card.token) return null
+                if (container.zone == PlayZone.BATTLEFIELD && card.placement != null && next.cards.count {
+                        it.containerId == container.id && it.placement?.pileId == card.placement.pileId
+                    } >= 3) return null
+                val ordered = container.zone in setOf(PlayZone.LIBRARY, PlayZone.HAND, PlayZone.STACK)
+                val index = if (loc.afterId == null) 0 else container.cards.indexOf(loc.afterId).takeIf { it >= 0 }?.plus(1) ?: return null
+                if (ordered && container.cards.getOrNull(index) != loc.beforeId) return null
+                next = next.copy(cards = (next.cards + card).sortedBy { it.id }, containers = next.containers.map {
+                    if (it.id != container.id) it else it.copy(cards = it.cards.toMutableList().apply {
+                        add(if (ordered) index else size, card.id)
+                    }.let { ids -> if (ordered) ids else ids.sorted() })
+                })
+            }
+        }
+        for (change in transition.links) change.from?.let { link ->
+            if (occupied(next, link.id) || !exists(next, link.first) || !exists(next, link.second) ||
+                next.links.any { pair(it.first, it.second) == pair(link.first, link.second) }) return null
+            next = next.copy(links = (next.links + link).sortedBy { it.id })
+        }
+        return next
+    }
+}
diff --git a/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/TreeSync.kt b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/TreeSync.kt
new file mode 100644
index 0000000..9d3ee1e
--- /dev/null
+++ b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/TreeSync.kt
@@ -0,0 +1,221 @@
+package org.asyncttwiz.protocol
+
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.*
+
+/** Flat accepted-record codec for the shared GameplayTree on the existing I14 baseline and
+ * GameRevision transport. Retained relational mutations/control records are the exporter input;
+ * an incremental delivery window is never relabelled as complete branched history.
+ */
+@Serializable data class TreeSyncRecord(val kind: String, val id: String, val payload: JsonElement, val version: Int = 1)
+@Serializable private data class TreeRedoQueue(val entries: List<GameplayRedoEntry>)
+@Serializable data class GameplayTreeKey(val kind: String, val id: String)
+@Serializable data class GameplayTreeDelta(val upserts: List<TreeSyncRecord>, val removals: List<GameplayTreeKey> = emptyList())
+
+/** Branch presentation payloads are retained verbatim. GameplayTree owns the explicit heads,
+ * lineage/archive/control semantics; this codec never guesses them from presentation filtering.
+ */
+data class DownloadedTree(val tree: GameplayTree, val branches: Map<String, JsonObject>)
+
+object TreeSync {
+    fun branchIds(tree: GameplayTree): Set<String> = setOf(tree.initial.root.branchId) +
+        tree.nodes.values.map { it.branchId } + tree.redoByAccount.values.flatten().map { it.mutation.branchId } +
+        tree.branchHeads.keys + tree.branches.keys + tree.currentBranchId
+
+    fun generation(tree: GameplayTree) = DownloadedTree(tree, branchIds(tree).associateWith { buildJsonObject { put("id", it) } })
+
+    fun delta(before: GameplayTree, after: GameplayTree): GameplayTreeDelta {
+        // Compare immutable records BEFORE encoding. Ordinary appends must not serialize every
+        // retained offshoot/board/control merely to discover that their bytes did not change.
+        val upserts = mutableListOf<TreeSyncRecord>()
+        val removals = mutableListOf<GameplayTreeKey>()
+        fun <T> changes(kind: String, old: Map<String, T>, next: Map<String, T>, encode: (T) -> JsonElement) {
+            (old.keys - next.keys).forEach { removals.add(GameplayTreeKey(kind, it)) }
+            next.forEach { (id, value) -> if (old[id] != value) upserts.add(TreeSyncRecord(kind, id, encode(value))) }
+        }
+        fun scalar(kind: String, old: String?, next: String?) = changes(kind,
+            old?.let { mapOf("current" to it) }.orEmpty(), next?.let { mapOf("current" to it) }.orEmpty(), ::JsonPrimitive)
+        changes("root", mapOf(before.initial.root.id to before.initial.copy(definitions = emptyList())),
+            mapOf(after.initial.root.id to after.initial.copy(definitions = emptyList()))) { GameWire.json.encodeToJsonElement(it) }
+        scalar("current", before.currentNodeId, after.currentNodeId)
+        scalar("selected-branch", before.currentBranchId, after.currentBranchId)
+        scalar("selection-control", before.selectionControlId, after.selectionControlId)
+        changes("node", before.nodes, after.nodes) { GameWire.json.encodeToJsonElement(it) }
+        changes("definition", before.initial.definitions.associateBy { it.digest }, after.initial.definitions.associateBy { it.digest }) { GameWire.json.encodeToJsonElement(it) }
+        changes("redo", before.redoByAccount, after.redoByAccount) { GameWire.json.encodeToJsonElement(TreeRedoQueue(it)) }
+        changes("removed-parent", before.removedParents, after.removedParents, ::JsonPrimitive)
+        changes("branch-head", before.branchHeads, after.branchHeads, ::JsonPrimitive)
+        changes("branch-lineage", before.branches, after.branches) { GameWire.json.encodeToJsonElement(it) }
+        changes("branch", branchIds(before).associateWith { it }, branchIds(after).associateWith { it }) { buildJsonObject { put("id", it) } }
+        changes("archived", before.branchArchives.archivedBranchIds.associateWith { true },
+            after.branchArchives.archivedBranchIds.associateWith { true }, ::JsonPrimitive)
+        changes("archive-control", before.branchArchives.lastControlByBranch, after.branchArchives.lastControlByBranch, ::JsonPrimitive)
+        changes("archive-record", before.branchArchives.records, after.branchArchives.records) { GameWire.json.encodeToJsonElement(it) }
+        return GameplayTreeDelta(upserts, removals)
+    }
+
+    fun apply(tree: DownloadedTree, delta: GameplayTreeDelta): DownloadedTree {
+        val records = records(tree).associateByTo(linkedMapOf()) { GameplayTreeKey(it.kind, it.id) }
+        require(delta.upserts.map { GameplayTreeKey(it.kind, it.id) }.distinct().size == delta.upserts.size)
+        require(delta.removals.distinct().size == delta.removals.size)
+        delta.removals.forEach { require(records.remove(it) != null) }
+        delta.upserts.forEach { require(GameplayTreeKey(it.kind, it.id) !in delta.removals); records[GameplayTreeKey(it.kind, it.id)] = it }
+        return decode(records.values.asSequence(), tree.tree.initial.gameId, tree.tree.initial.id)
+    }
+
+    /** No recursive graph or per-node board snapshots. Definitions and common ancestors occur once. */
+    fun records(generation: DownloadedTree): Sequence<TreeSyncRecord> = sequence {
+        val tree = generation.tree
+        yield(TreeSyncRecord("root", tree.initial.root.id, GameWire.json.encodeToJsonElement(tree.initial.copy(definitions = emptyList()))))
+        yield(TreeSyncRecord("current", "current", JsonPrimitive(tree.currentNodeId)))
+        yield(TreeSyncRecord("selected-branch", "current", JsonPrimitive(tree.currentBranchId)))
+        tree.selectionControlId?.let { yield(TreeSyncRecord("selection-control", "current", JsonPrimitive(it))) }
+        tree.branchHeads.toSortedMap().forEach { (id, head) -> yield(TreeSyncRecord("branch-head", id, JsonPrimitive(head))) }
+        tree.branches.toSortedMap().forEach { (id, branch) -> yield(TreeSyncRecord("branch-lineage", id, GameWire.json.encodeToJsonElement(branch))) }
+        tree.branchArchives.archivedBranchIds.sorted().forEach { yield(TreeSyncRecord("archived", it, JsonPrimitive(true))) }
+        tree.branchArchives.lastControlByBranch.toSortedMap().forEach { (id, control) -> yield(TreeSyncRecord("archive-control", id, JsonPrimitive(control))) }
+        tree.branchArchives.records.toSortedMap().forEach { (id, record) -> yield(TreeSyncRecord("archive-record", id, GameWire.json.encodeToJsonElement(record))) }
+        tree.initial.definitions.sortedBy { it.digest }.forEach {
+            yield(TreeSyncRecord("definition", it.digest, GameWire.json.encodeToJsonElement(it)))
+        }
+        tree.nodes.toSortedMap().forEach { (id, node) -> yield(TreeSyncRecord("node", id, GameWire.json.encodeToJsonElement(node))) }
+        tree.redoByAccount.toSortedMap().forEach { (account, queue) ->
+            yield(TreeSyncRecord("redo", account, GameWire.json.encodeToJsonElement(TreeRedoQueue(queue))))
+        }
+        tree.removedParents.toSortedMap().forEach { (id, parent) -> yield(TreeSyncRecord("removed-parent", id, JsonPrimitive(parent))) }
+        generation.branches.toSortedMap().forEach { (id, metadata) -> yield(TreeSyncRecord("branch", id, metadata)) }
+    }
+
+    /** Stream flat records into the SAME shared immutable tree. Full coverage is a server-exporter
+     * obligation; closed topology, byte hashes/counts and replay cannot prove an omitted offshoot.
+     */
+    fun decode(records: Sequence<TreeSyncRecord>, gameId: String, playId: String): DownloadedTree {
+        var initial: PlayState? = null
+        var current: String? = null
+        var selectedBranch: String? = null
+        var selectionControl: String? = null
+        val heads = linkedMapOf<String, String>()
+        val lineage = linkedMapOf<String, GameplayBranch>()
+        val archived = linkedSetOf<String>()
+        val archiveControls = linkedMapOf<String, String>()
+        val archiveRecords = linkedMapOf<String, BranchArchiveRecord>()
+        val nodes = linkedMapOf<String, GameplayMutation>()
+        val definitions = linkedMapOf<String, SubmittedDefinition>()
+        val redo = linkedMapOf<String, List<GameplayRedoEntry>>()
+        val removed = linkedMapOf<String, String>()
+        val branches = linkedMapOf<String, JsonObject>()
+        val seen = mutableSetOf<Pair<String, String>>()
+        for (record in records) {
+            require(record.version == 1 && seen.add(record.kind to record.id)) { "Duplicate/unsupported tree record" }
+            when (record.kind) {
+                "root" -> {
+                    require(initial == null)
+                    initial = GameWire.json.decodeFromJsonElement<PlayState>(record.payload)
+                    require(initial.root.id == record.id && initial.definitions.isEmpty())
+                }
+                "current" -> { require(record.id == "current"); current = record.payload.jsonPrimitive.content }
+                "selected-branch" -> { require(record.id == "current"); selectedBranch = record.payload.jsonPrimitive.content }
+                "selection-control" -> { require(record.id == "current"); selectionControl = record.payload.jsonPrimitive.content }
+                "branch-head" -> heads[record.id] = record.payload.jsonPrimitive.content
+                "branch-lineage" -> lineage[record.id] = GameWire.json.decodeFromJsonElement<GameplayBranch>(record.payload).also { require(it.id == record.id) }
+                "archived" -> { require(record.payload.jsonPrimitive.boolean); archived.add(record.id) }
+                "archive-control" -> archiveControls[record.id] = record.payload.jsonPrimitive.content
+                "archive-record" -> archiveRecords[record.id] = GameWire.json.decodeFromJsonElement<BranchArchiveRecord>(record.payload).also { require(it.request.requestId == record.id) }
+                "definition" -> {
+                    val definition = GameWire.json.decodeFromJsonElement<SubmittedDefinition>(record.payload)
+                    require(definition.digest == record.id && DeckValidation.definition(definition.definition) &&
+                        DeckJson.digest(definition.definition) == definition.digest)
+                    definitions[record.id] = definition
+                }
+                "node" -> {
+                    val node = GameWire.json.decodeFromJsonElement<GameplayMutation>(record.payload)
+                    require(node.id == record.id); nodes[record.id] = node
+                }
+                "redo" -> redo[record.id] = GameWire.json.decodeFromJsonElement<TreeRedoQueue>(record.payload).entries
+                "removed-parent" -> removed[record.id] = record.payload.jsonPrimitive.content
+                "branch" -> branches[record.id] = record.payload.jsonObject
+                else -> error("Unsupported tree record") // missing semantics are incomplete, not silently dropped
+            }
+        }
+        val root = requireNotNull(initial).copy(definitions = definitions.values.sortedBy { it.digest })
+        require(root.gameId == gameId && root.id == playId)
+        val result = DownloadedTree(GameplayTree(root, nodes, requireNotNull(current), redo, removed, lineage,
+            selectedBranch ?: nodes[current]?.branchId ?: root.root.branchId,
+            BranchArchiveState(archived, archiveControls, archiveRecords),
+            if (heads.isEmpty()) mapOf(root.root.branchId to root.root.id) else heads, selectionControl), branches)
+        validate(result)
+        return result
+    }
+
+    /** Iterative full retained-tree validation/replay. No Undo-only ceiling, recursive ancestry or
+     * cached board per node. A linear path retains one working board; forks share their parent state.
+     * Call off the UI thread, just like cold GameplayTree.stateAt().
+     */
+    fun validate(generation: DownloadedTree) {
+        val tree = generation.tree
+        val root = tree.initial
+        require(root.engineVersion == 1 && root.readFormat == 1 && root.board.schemaVersion == 1 && root.root.parentId == null &&
+            root.currentNodeId == root.root.id && root.currentGroup == null)
+        require(listOf(root.gameId, root.id, root.root.id, root.root.branchId).all(DeckValidation::uuid))
+        val players = root.board.players.map { it.accountId }.toSet()
+        require(players.size == 2 && root.board.players.size == 2 && root.board.turn.accountId in players)
+        val definitions = root.definitions.associateBy { it.digest }
+        require(definitions.size == root.definitions.size && root.definitions.all {
+            DeckValidation.definition(it.definition) && DeckJson.digest(it.definition) == it.digest })
+        val cards = root.board.cards.associateBy { it.id }
+        val containers = root.board.containers.associateBy { it.id }
+        require(cards.size == root.board.cards.size && containers.size == root.board.containers.size)
+        require(root.board.cards.all { card -> card.owner in players &&
+            definitions[card.definition]?.definition?.faces?.any { it.faceId == card.faceId } == true &&
+            containers[card.containerId]?.cards?.contains(card.id) == true })
+        val members = root.board.containers.flatMap { it.cards }
+        require(members.size == cards.size && members.toSet() == cards.keys)
+        require(root.root.id !in tree.nodes && root.root.id !in tree.removedParents)
+        require(tree.currentNodeId == root.root.id || tree.currentNodeId in tree.nodes)
+        require(generation.branches.keys == branchIds(tree)) { "Missing retained branch metadata" }
+        require(generation.branches.keys.all(DeckValidation::uuid))
+        require(tree.currentBranchId in generation.branches && tree.currentBranchId !in tree.branchArchives.archivedBranchIds)
+        require(tree.branchHeads.all { (id, head) -> id in generation.branches && tree.resolveCursor(head) != null })
+        require(tree.branchArchives.archivedBranchIds.all { it in tree.branchHeads })
+        tree.selectionControlId?.let { require(DeckValidation.uuid(it)) }
+        require(tree.nodes.all { (id, node) -> id == node.id && node.author in players &&
+            listOf(id, node.parentId, node.branchId, node.requestId).all(DeckValidation::uuid) &&
+            node.schemaVersion == 1 && tree.referencesMatch(node) })
+        val children = tree.nodes.values.groupBy { it.parentId }
+        val pending = ArrayDeque<Pair<GameplayMutation, PlayState>>()
+        children[root.root.id].orEmpty().forEach { pending.add(it to root) }
+        val visited = mutableSetOf<String>()
+        while (pending.isNotEmpty()) {
+            val (node, parent) = pending.removeLast()
+            require(visited.add(node.id)) { "Cyclic retained topology" }
+            val state = requireNotNull(tree.replay(parent, node)) { "Unreplayable retained node" }
+            children[node.id].orEmpty().forEach { pending.add(it to state) }
+        }
+        require(visited.size == tree.nodes.size) { "Missing/disconnected retained ancestry" }
+        require(tree.removedParents.keys.none { it in tree.nodes })
+        require(tree.removedParents.all { (id, parent) -> DeckValidation.uuid(id) && DeckValidation.uuid(parent) })
+        // Resolve all removal routes in linear work, including chains across multiple pruned edits.
+        val resolved = (tree.nodes.keys + root.root.id).toMutableSet()
+        for (id in tree.removedParents.keys) {
+            val route = mutableSetOf<String>()
+            var at = id
+            while (at !in resolved) {
+                require(route.add(at)) { "Cyclic removed-parent metadata" }
+                at = requireNotNull(tree.removedParents[at]) { "Incomplete removed-parent metadata" }
+            }
+            resolved.addAll(route)
+        }
+        require(tree.redoByAccount.keys.all { it in players })
+        require(tree.redoByAccount.all { (account, queue) -> queue.all { entry -> entry.mutation.author == account &&
+            (entry.successorId == null || entry.successorId in resolved) && entry.otherChildIds.all { it in resolved } } })
+        val detached = tree.redoByAccount.values.flatten().map { it.mutation }
+        require(detached.map { it.id }.distinct().size == detached.size)
+        val referencePayloads = tree.nodes + detached.associateBy { it.id }
+        require(detached.all { node -> node.id !in tree.nodes && node.id in tree.removedParents && node.author in players &&
+            listOf(node.id, node.parentId, node.branchId, node.requestId).all(DeckValidation::uuid) &&
+            node.schemaVersion == 1 && node.parentId in resolved && node.references.all {
+                referencePayloads[it.nodeId]?.transition == it.transition } })
+    }
+
+    fun digest(bytes: ByteArray) = "sha256:" + sha256(bytes)
+}
