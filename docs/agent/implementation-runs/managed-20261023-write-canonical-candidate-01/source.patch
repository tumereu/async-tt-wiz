--- /dev/null
+++ b/androidApp/src/main/kotlin/org/asyncttwiz/android/TableActionMenu.kt
@@ -0,0 +1,110 @@
+package org.asyncttwiz.android
+
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.window.Dialog
+import org.asyncttwiz.protocol.*
+
+data class TableMenuAction(val name: String, val intent: TableActionIntent)
+
+/** Full constituent routes have no quick-window gates. Library/card/occurrence entry points use
+ * the same typed intents as the quick strip, so the host opens the actual corresponding component. */
+object TableActionMenus {
+    fun table(play: PlayState, context: QuickContext, controller: TableActionController,
+        pendingSuggestionId: String? = null, mayAccept: Boolean = false): List<TableMenuAction> {
+        val scope = TableActionScope(play.gameId, play.id)
+        val actions = mutableListOf(
+            TableMenuAction("Next step", TableActionIntent.Next(scope)),
+            TableMenuAction("End turn", TableActionIntent.End(scope)))
+        controller.untap(play, false)?.let { actions += TableMenuAction("Untap all", it) }
+        controller.draw(play, false)?.let { actions += TableMenuAction("Draw one", it) }
+        actions += TableMenuAction("Create combat area", TableActionIntent.Combat(scope, CombatTool.CREATE, context.combatAreaId))
+        actions += TableMenuAction("Close combat area", TableActionIntent.Combat(scope, CombatTool.CLOSE, context.combatAreaId))
+        actions += TableMenuAction("Create token / Blank", TableActionIntent.Token(scope))
+        if (pendingSuggestionId == null) {
+            actions += TableMenuAction("Suggest my win", TableActionIntent.Ending(scope, EndingTool.SUGGEST_WIN))
+            actions += TableMenuAction("Suggest my loss", TableActionIntent.Ending(scope, EndingTool.SUGGEST_LOSS))
+            actions += TableMenuAction("Suggest draw", TableActionIntent.Ending(scope, EndingTool.SUGGEST_DRAW))
+        } else if (mayAccept) actions += TableMenuAction("Accept result", TableActionIntent.Ending(scope, EndingTool.ACCEPT, pendingSuggestionId))
+        return actions
+    }
+
+    fun library(play: PlayState, targets: TurnPlayerTargets, controller: TableActionController): List<TableMenuAction> =
+        LibraryTool.entries.mapNotNull { tool -> controller.library(play, tool, targets)?.let {
+            TableMenuAction(when (tool) {
+                LibraryTool.CONTENTS -> "Library contents"
+                LibraryTool.DRAW_N -> "Draw N"
+                LibraryTool.VIEW -> "View"
+                LibraryTool.REVEAL -> "Reveal"
+                LibraryTool.SHUFFLE -> "Shuffle all"
+                LibraryTool.MULLIGAN_N -> "Return Hand → Shuffle → Draw N"
+                LibraryTool.MULLIGAN_MINUS_ONE -> "Return Hand → Shuffle → Draw previous Hand size −1"
+            }, it)
+        } }
+
+    fun declaration(scope: TableActionScope, areaId: String?, sourceIds: List<String>) = listOf(
+        TableMenuAction("Declare without tapping", TableActionIntent.Combat(scope, CombatTool.DECLARE, areaId, sourceIds.distinct())),
+        TableMenuAction("Declare + tap", TableActionIntent.Combat(scope, CombatTool.DECLARE_AND_TAP, areaId, sourceIds.distinct())),
+        TableMenuAction("Tap", TableActionIntent.Orient(scope, sourceIds.distinct(), true)),
+        TableMenuAction("Untap", TableActionIntent.Orient(scope, sourceIds.distinct(), false)))
+
+    fun stack(scope: TableActionScope, target: ExplicitStackTarget) = listOf(TableMenuAction(when (target.kind) {
+        StackTargetKind.INSTANT_OR_SORCERY -> "Move to Graveyard"
+        StackTargetKind.PERMANENT -> "Move to Battlefield"
+        StackTargetKind.EFFECT -> "Remove this effect"
+    }, TableActionIntent.Stack(scope, target)))
+}
+
+/** Actual phase and random input controls plus routes to the other capability components.
+ * A die has only a sides input; no preselected result or result chooser exists. */
+@Composable
+fun TableActionMenu(play: PlayState, viewerId: String, context: QuickContext, controller: TableActionController,
+    endingPlayerColor: Color, onDismiss: () -> Unit, pendingSuggestionId: String? = null, mayAccept: Boolean = false,
+    perform: (TableActionIntent) -> Boolean = controller::perform) {
+    val scope = TableActionScope(play.gameId, play.id)
+    var sides by remember(scope) { mutableStateOf("6") }
+    var picker by remember(scope) { mutableStateOf(false) }
+    Dialog(onDismissRequest = onDismiss) {
+        Surface {
+            Column(Modifier.padding(12.dp).verticalScroll(rememberScrollState())) {
+                Text("Table actions", style = MaterialTheme.typography.titleMedium)
+                TextButton(enabled = context.playable && controller.enabled(scope), onClick = { picker = true }) { Text("Choose phase/step") }
+                for (entry in TableActionMenus.table(play, context, controller, pendingSuggestionId, mayAccept)) {
+                    val end = entry.intent is TableActionIntent.End
+                    Button(enabled = context.playable && controller.enabled(scope),
+                        colors = ButtonDefaults.buttonColors(containerColor = if (end) endingPlayerColor else MaterialTheme.colorScheme.primary),
+                         onClick = { perform(entry.intent) }) {
+                        Text(if (end && play.board.turn.accountId != viewerId) "End opponent's turn" else entry.name)
+                    }
+                }
+                OutlinedTextField(sides, { sides = it }, label = { Text("Die sides") }, singleLine = true,
+                    isError = sides.toIntOrNull()?.let { it <= 0 } != false)
+                TextButton(enabled = context.playable && controller.enabled(scope) && (sides.toIntOrNull() ?: 0) > 0,
+                    onClick = { sides.toIntOrNull()?.let { controller.rollDie(scope, it) } }) { Text("Roll die") }
+                TextButton(enabled = context.playable && controller.enabled(scope),
+                    onClick = { controller.flipCoin(scope) }) { Text("Flip coin") }
+            }
+        }
+    }
+    if (picker) PhaseStepPicker(play, viewerId, endingPlayerColor, controller, onDismiss = { picker = false })
+}
+
+/** Reusable full Library/card/occurrence menu, usable at every phase. All callbacks are typed. */
+@Composable
+fun ConstituentActionMenu(entries: List<TableMenuAction>, controller: TableActionController,
+    onDismiss: () -> Unit) {
+    Dialog(onDismissRequest = onDismiss) {
+        Surface {
+            Column(Modifier.padding(8.dp).verticalScroll(rememberScrollState())) {
+                for (entry in entries) TextButton(enabled = controller.enabled(entry.intent.scope),
+                    onClick = { controller.perform(entry.intent) }) { Text(entry.name) }
+            }
+        }
+    }
+}
diff --git a/androidApp/src/main/kotlin/org/asyncttwiz/android/TableActionsScreen.kt b/androidApp/src/main/kotlin/org/asyncttwiz/android/TableActionsScreen.kt
new file mode 100644
index 0000000..aebb98d
--- /dev/null
+++ b/androidApp/src/main/kotlin/org/asyncttwiz/android/TableActionsScreen.kt
@@ -0,0 +1,131 @@
+package org.asyncttwiz.android
+
+import androidx.compose.foundation.horizontalScroll
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.window.Dialog
+import org.asyncttwiz.protocol.*
+import java.util.UUID
+
+/** Basic controls on the real route. Unsupported View/Shuffle/toolkit controls are not fake buttons. */
+@Composable
+internal fun TableActionsScreen(game: GameSummary, play: PlayState, viewer: String,
+    captured: TableIntent.Actions, item: TableItem, selection: TableSelection, enabled: Boolean,
+    landscape: Boolean, dismiss: () -> Unit, inspect: (String) -> Unit, select: (String) -> Unit,
+    open: (String) -> Unit, request: (TableIntent) -> Boolean, submit: (PlayAction, String?) -> Boolean) {
+    val names = mapOf(game.inviter.accountId to game.inviter.username, game.recipient.accountId to game.recipient.username)
+    if (item.kind in listOf(TableItemKind.LIFE, TableItemKind.COUNTER)) {
+        val manual = remember(play.id, captured) { ManualActions().apply { player(play, requireNotNull(item.owner)) } }
+        if (manual.scope == null) { SideEffect(dismiss); return }
+        ManualActionsHost(play, viewer, manual, enabled, landscape, names) { action -> submit(action, UUID.randomUUID().toString()) }
+        return
+    }
+    val context = captured.scope?.contextId
+    val card = play.board.cards.singleOrNull { it.id == context }
+    val container = play.board.containers.singleOrNull { it.id == item.id }
+    // Browser card entries are real IDs, even when not independently drawn on the Canvas.
+    if (context != null && card == null) { SideEffect(dismiss); return }
+    Dialog(onDismissRequest = dismiss) {
+        Surface(shape = MaterialTheme.shapes.large) {
+            Column(Modifier.padding(12.dp).heightIn(max = 520.dp).verticalScroll(rememberScrollState())) {
+                if (card != null) {
+                    val scope = requireNotNull(captured.scope)
+                    // Do not use own-area hold permission to expose a covered face in Actions.
+                    Text(if (card.covered) "Covered card" else play.definitions.singleOrNull { it.digest == card.definition }
+                        ?.definition?.faces?.singleOrNull { it.faceId == card.faceId }?.name ?: "Card unavailable")
+                    Text("${scope.cardIds.size} captured targets · ${if (card.tapped) "tapped" else "untapped"}")
+                    Row {
+                        ActionSquare("Inspect", "⌕", enabled = true, onClick = { inspect(card.id) })
+                        ActionSquare("Select / deselect", "☑", enabled = true, selected = card.id in selection.ids, onClick = { select(card.id) })
+                        if (selection.mode == TableMode.SELECT) {
+                            ActionSquare("Tap selected scope", "↷", enabled, onClick = { request(TableIntent.Rotate(scope, true)) })
+                            ActionSquare("Untap selected scope", "↑", enabled, onClick = { request(TableIntent.Rotate(scope, false)) })
+                        }
+                    }
+                    BasicMoveControls(play, names, enabled, scope, captured.sources, request, dismiss)
+                } else if (container != null) {
+                    Text(item.label)
+                    if (container.zone == PlayZone.LIBRARY) {
+                        // Full-library View is logged and not implemented by the pinned processor.
+                        // A top-card move exposes no identity/order through this Actions panel.
+                        val top = captured.topId
+                        if (top == null) Text("Empty Library") else {
+                            val scope = remember(captured) { TableScope(top, listOf(top)) }
+                            val sources = captured.sources.filterKeys { it == top }
+                            val hand = play.board.containers.single { it.zone == PlayZone.HAND && it.accountId == container.accountId }
+                            ActionSquare("Draw one", "↓", enabled, onClick = {
+                                if (request(TableIntent.Move(scope, TableDestination.Container(hand.id, hand.zone), sources))) dismiss()
+                            })
+                            BasicMoveControls(play, names, enabled, scope, sources, request, dismiss, topCard = true)
+                        }
+                    } else {
+                        if (container.cards.isEmpty()) Text("Empty")
+                        // Covered entries stay covered. Library is deliberately excluded from this local list.
+                        for (id in container.cards.sorted()) {
+                            val entry = play.board.cards.single { it.id == id }
+                            val title = if (entry.covered) "Covered card" else play.definitions.singleOrNull { it.digest == entry.definition }
+                                ?.definition?.faces?.singleOrNull { it.faceId == entry.faceId }?.name ?: "Card unavailable"
+                            TextButton(onClick = { open(id) }) { Text(title) }
+                        }
+                    }
+                }
+                if (!enabled) Text("Read-only")
+            }
+        }
+    }
+}
+
+@Composable
+internal fun BasicMoveControls(play: PlayState, names: Map<String, String>, enabled: Boolean, scope: TableScope,
+    sources: Map<String, TableMoveSource>, request: (TableIntent) -> Boolean, dismiss: () -> Unit, topCard: Boolean = false) {
+    for (player in play.board.players) {
+        Text(names[player.accountId].orEmpty(), style = MaterialTheme.typography.labelSmall)
+        Row(Modifier.horizontalScroll(rememberScrollState())) {
+            for (zone in listOf(PlayZone.HAND, PlayZone.BATTLEFIELD, PlayZone.LIBRARY, PlayZone.GRAVEYARD, PlayZone.EXILE)) {
+                val target = play.board.containers.single { it.accountId == player.accountId && it.zone == zone }
+                val choices = if (zone == PlayZone.LIBRARY) listOf(false, true) else listOf(false)
+                for (bottom in choices) {
+                    val label = "Move ${if (topCard) "top card " else ""}to ${names[player.accountId]} ${zone.name.lowercase()}" +
+                        if (zone == PlayZone.LIBRARY) if (bottom) " bottom" else " top" else ""
+                    // The destination cell is captured by this rendered control, not recomputed in a later callback.
+                    val destination = remember(scope, sources, target.id, bottom) {
+                        if (zone == PlayZone.BATTLEFIELD) {
+                            val occupied = play.board.cards.filter { it.containerId == target.id }.mapNotNull { it.placement?.position }.toSet()
+                            val column = generateSequence(0) { it + 1 }.first { BoardPosition(it, 0) !in occupied }
+                            TableDestination.Grid(target.id, column, 0)
+                        } else TableDestination.Container(target.id, zone, bottom)
+                    }
+                    ActionSquare(label, when (zone) {
+                        PlayZone.HAND -> "↓"; PlayZone.BATTLEFIELD -> "▦"; PlayZone.LIBRARY -> if (bottom) "⇓" else "⇑"
+                        PlayZone.GRAVEYARD -> "†"; else -> "◇"
+                    }, enabled, onClick = { if (request(TableIntent.Move(scope, destination, sources))) dismiss() })
+                }
+            }
+        }
+    }
+    val stack = play.board.containers.single { it.zone == PlayZone.STACK }
+    ActionSquare("Move to Stack", "▱", enabled, onClick = {
+        if (request(TableIntent.Move(scope, TableDestination.Container(stack.id, stack.zone), sources))) dismiss()
+    })
+    // Snapshot the same real-card destination used by dragging; sync must not replace an open choice.
+    val piles = remember(scope, sources) { basicPileDestinations(play, scope) }
+    for (destination in piles) {
+        val source = requireNotNull(destination.source)
+        val position = requireNotNull(source.placement)
+        val owner = play.board.containers.singleOrNull { it.id == source.containerId }?.accountId
+        ActionSquare("Move to ${names[owner]} pile (${position.column.toInt()}, ${position.row.toInt()})", "▤", enabled,
+            onClick = { if (request(TableIntent.Move(scope, destination, sources))) dismiss() })
+    }
+}
+
+internal fun basicPileDestinations(play: PlayState, scope: TableScope): List<TableDestination.CardPile> =
+    play.board.cards.filter { it.placement != null && it.id !in scope.cardIds }
+        .distinctBy { it.containerId to it.placement }.filter { card ->
+            val members = play.board.cards.filter { it.containerId == card.containerId && it.placement == card.placement }.map { it.id }
+            (members + scope.cardIds).distinct().size <= 3
+        }.map { card -> TableDestination.CardPile(card.id, BasicTableController.sources(play, listOf(card.id)).getValue(card.id)) }
