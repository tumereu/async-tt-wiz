new file mode 100644
index 0000000..d4d6df6
--- /dev/null
+++ b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/HistoryContinuation.kt
@@ -0,0 +1,58 @@
+package org.asyncttwiz.protocol
+
+import kotlinx.serialization.Serializable
+
+/** Immutable lineage and original displaced selection for return/recovery. Explicit current heads
+ * live in GameplayTree.branchHeads, never an inferred subtree. Original references can later be
+ * removed by Undo; consumers must resolve them explicitly, not substitute a representative/group end.
+ */
+@Serializable data class GameplayBranch(val id: String, val forkNodeId: String, val firstNodeId: String,
+    val createdByRequestId: String, val author: String, val displacedNodeId: String, val displacedBranchId: String,
+    val displacedVersion: String? = null)
+
+/** Processing-time controls on the existing tree. The single durable FIFO adapter must recover an
+ * original inbox outcome BEFORE calling this function; it owns lifecycle, ordering and atomic commit.
+ * Like ordinary play, cold reconstruction belongs on a worker, never the UI thread.
+ */
+object HistoryContinuation {
+    fun change(tree: GameplayTree, actor: String, command: GameCommand): GameplayTreeChange {
+        if (!GameWire.valid(command)) return GameplayTreeChange(reason = "invalidInput")
+        if (command.scope.gameId != tree.initial.gameId || command.scope.playId != tree.initial.id)
+            return GameplayTreeChange(reason = "inapplicable")
+        if (actor !in tree.initial.board.players.map { it.accountId }) return GameplayTreeChange(reason = "accessDenied")
+        val change = when (val action = command.action) {
+            is GameAction.Play -> tree.play(actor, command)
+            GameAction.Undo, GameAction.Redo -> SelectiveUndo.change(tree, actor, command)
+            is GameAction.BranchArchive -> BranchArchives.change(tree, tree.archiveCatalog(), actor,
+                BranchArchiveRequest(command.requestId, command.scope, action.intent)).let {
+                    // Original outcomes live in the existing inbox, not a second mutation journal.
+                    if (it.outcome != "accepted") GameplayTreeChange(reason = it.reason)
+                    else GameplayTreeChange(it.tree, targetId = it.selection?.nodeId)
+                }
+            is GameAction.MakeCurrent -> {
+                if (tree.stateAt(action.nodeId) == null) GameplayTreeChange(reason = "missingReference")
+                else tree.activate(action.nodeId)
+            }
+            else -> GameplayTreeChange(reason = "invalidInput")
+        }
+        val next = change.tree ?: return change
+        if (command.action == GameAction.Undo || command.action == GameAction.Redo) {
+            tree.selectiveReferenceFailure(next)?.let { return GameplayTreeChange(reason = it, targetId = change.targetId) }
+        }
+        val heads = next.branchHeads.mapValues { (_, node) -> next.resolveCursor(node) ?: next.initial.root.id }.toMutableMap()
+        if (command.action == GameAction.Redo) {
+            // Undo of an actual branch head records its surviving parent. Reinsertion at that same
+            // still-terminal boundary restores the head; it must not leave catalog/head behind the
+            // current board or overwrite a newer opponent continuation.
+            val entry = tree.redoByAccount[actor]?.lastOrNull()
+            if (entry != null && entry.successorId == null && heads[entry.mutation.branchId] == entry.mutation.parentId)
+                heads[entry.mutation.branchId] = entry.mutation.id
+        }
+        val switched = command.action is GameAction.MakeCurrent ||
+            (command.action is GameAction.BranchArchive &&
+                (next.currentBranchId != tree.currentBranchId || next.currentNodeId != tree.currentNodeId))
+        if (heads == next.branchHeads && !switched) return change
+        return change.copy(tree = next.copy(branchHeads = heads,
+            selectionControlId = if (switched) command.requestId else next.selectionControlId))
+    }
+}
diff --git a/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/HistoryGrouping.kt b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/HistoryGrouping.kt
new file mode 100644
index 0000000..28a46ac
--- /dev/null
+++ b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/HistoryGrouping.kt
@@ -0,0 +1,144 @@
+package org.asyncttwiz.protocol
+
+import kotlinx.serialization.Serializable
+
+/** Semantic presentation categories, not request types or rules-engine interpretations. */
+@Serializable enum class HistoryCategory(val key: String) {
+    T("tap"), M("move"), I("stack"), E("edit"), C("creation"), K("combat"), L("stackLayout"),
+    V("view"), H("shuffle"), F("closure"), R("random"), P("ping"), B("backward"), S("ending"), O("leading")
+}
+
+/** D-299 ranks. The representative retains the event's literal icon, never a rank-label icon. */
+@Serializable enum class HistorySignificance(val category: HistoryCategory, val rank: Int, val anchor: Boolean = true) {
+    ENDING_SUGGESTION(HistoryCategory.S, 10), STACK_ENTRY(HistoryCategory.I, 20), STACK_REMOVAL(HistoryCategory.I, 20),
+    EXPLICIT_DISCLOSURE(HistoryCategory.V, 30), TOKEN_CLONE_CREATION(HistoryCategory.C, 40),
+    COMBAT_MEMBERSHIP(HistoryCategory.K, 50), COMBAT_AREA_CREATION(HistoryCategory.K, 60),
+    CROSS_ZONE_MOVE(HistoryCategory.M, 70), SHUFFLE(HistoryCategory.H, 80), TOKEN_REMOVAL(HistoryCategory.E, 90),
+    FACE_COVER_EDIT(HistoryCategory.E, 100), LIFE_PLAYER_COUNTER_EDIT(HistoryCategory.E, 110),
+    CARD_CORNER_COUNTER_EDIT(HistoryCategory.E, 120), OWNER_EDIT(HistoryCategory.E, 130),
+    LINK_EDIT(HistoryCategory.E, 140), CARD_TEXT_NOTE_EDIT(HistoryCategory.E, 150),
+    COMBAT_LAYOUT(HistoryCategory.K, 160), STACK_LAYOUT(HistoryCategory.L, 170), SAME_ZONE_PLACEMENT(HistoryCategory.M, 180),
+    COMBAT_CLOSURE(HistoryCategory.F, 10, false), VIEW_REVEAL_DISMISSAL(HistoryCategory.F, 20, false),
+    DIE_COIN_RUN(HistoryCategory.R, 30, false), ORIENTATION(HistoryCategory.T, 40, false),
+    TURN_TRANSITION(HistoryCategory.B, 50, false), PHASE_STEP_TRACKING(HistoryCategory.B, 60, false),
+    EVENT_COMMENT(HistoryCategory.B, 70, false), PING(HistoryCategory.P, 80, false)
+}
+
+@Serializable data class HistorySemantic(val significance: HistorySignificance, val icon: String, val key: String? = null) {
+    init {
+        require(icon.isNotBlank())
+        require((significance.category in setOf(HistoryCategory.M, HistoryCategory.H)) == (key != null))
+    }
+    val category: HistoryCategory get() = significance.category
+}
+@Serializable data class HistoryRepresentative(val nodeId: String, val semantic: HistorySemantic)
+
+object HistoryGrouping {
+    /** Exhaustive mapping of the actual implemented catalog. New tools must add their exact mapping here.
+     * Zone identity comes from accepted containers, not labels, card text, timers or invocation proximity. */
+    fun classify(action: PlayAction, containers: List<PlayContainer> = emptyList(),
+        transition: GameplayTransition? = null): HistorySemantic = when (action) {
+        is PlayAction.SuggestResult -> HistorySemantic(HistorySignificance.ENDING_SUGGESTION, "flag")
+        is PlayAction.SetTapped -> HistorySemantic(HistorySignificance.ORIENTATION, "rotate_90_degrees_cw")
+        is PlayAction.SetLife, is PlayAction.AdjustLife -> HistorySemantic(HistorySignificance.LIFE_PLAYER_COUNTER_EDIT, "favorite")
+        is PlayAction.SetPlayerCounter, is PlayAction.AdjustPlayerCounter ->
+            HistorySemantic(HistorySignificance.LIFE_PLAYER_COUNTER_EDIT, "exposure_plus_1")
+        PlayAction.EndTurn -> HistorySemantic(HistorySignificance.TURN_TRANSITION, "outlined_flag")
+        PlayAction.NextStep -> HistorySemantic(if (transition?.fields?.any { it.field == GameplayField.TURN_PLAYER } == true)
+            HistorySignificance.TURN_TRANSITION else HistorySignificance.PHASE_STEP_TRACKING, "outlined_flag")
+        is PlayAction.ChooseStep -> HistorySemantic(HistorySignificance.PHASE_STEP_TRACKING, "outlined_flag")
+        is PlayAction.RollDie -> HistorySemantic(HistorySignificance.DIE_COIN_RUN, "casino")
+        is PlayAction.FlipCoin -> HistorySemantic(HistorySignificance.DIE_COIN_RUN, "monetization_on")
+        is PlayAction.ShuffleLibrary -> HistorySemantic(HistorySignificance.SHUFFLE, "shuffle", action.containerId)
+        is PlayAction.ShowContents -> HistorySemantic(HistorySignificance.EXPLICIT_DISCLOSURE,
+            if (action.reveal) "visibility" else "pageview")
+        is PlayAction.DismissContents -> HistorySemantic(HistorySignificance.VIEW_REVEAL_DISMISSAL, "close")
+        is PlayAction.EventComment -> HistorySemantic(HistorySignificance.EVENT_COMMENT, "chat_bubble")
+        is PlayAction.Ping, is PlayAction.Unping -> HistorySemantic(HistorySignificance.PING, "ads_click")
+        is PlayAction.SetCorner, is PlayAction.AdjustCorner, is PlayAction.ClearCardCounter ->
+            HistorySemantic(HistorySignificance.CARD_CORNER_COUNTER_EDIT, "exposure_plus_1")
+        is PlayAction.ResetCorner -> HistorySemantic(HistorySignificance.CARD_CORNER_COUNTER_EDIT, "settings_backup_restore")
+        is PlayAction.SetCounter -> HistorySemantic(if (action.target == CounterTarget.PLAYER)
+            HistorySignificance.LIFE_PLAYER_COUNTER_EDIT else HistorySignificance.CARD_CORNER_COUNTER_EDIT, "exposure_plus_1")
+        is PlayAction.AdjustCounter -> HistorySemantic(if (action.target == CounterTarget.PLAYER)
+            HistorySignificance.LIFE_PLAYER_COUNTER_EDIT else HistorySignificance.CARD_CORNER_COUNTER_EDIT, "exposure_plus_1")
+        is PlayAction.SetNote -> HistorySemantic(HistorySignificance.CARD_TEXT_NOTE_EDIT, "sticky_note_2")
+        is PlayAction.SetOwner -> HistorySemantic(HistorySignificance.OWNER_EDIT, "switch_account")
+        is PlayAction.SetFace -> HistorySemantic(HistorySignificance.FACE_COVER_EDIT, "flip_camera_android")
+        is PlayAction.SetCovered -> HistorySemantic(HistorySignificance.FACE_COVER_EDIT,
+            if (action.covered) "flip" else "flip_to_front")
+        is PlayAction.InspectFace -> HistorySemantic(HistorySignificance.EXPLICIT_DISCLOSURE, "visibility")
+        is PlayAction.CreateToken -> HistorySemantic(HistorySignificance.TOKEN_CLONE_CREATION, "add_box")
+        is PlayAction.CloneToken -> HistorySemantic(HistorySignificance.TOKEN_CLONE_CREATION, "control_point_duplicate")
+        is PlayAction.RemoveToken -> HistorySemantic(HistorySignificance.TOKEN_REMOVAL, "delete")
+        is PlayAction.Link, is PlayAction.LinkProjections -> HistorySemantic(HistorySignificance.LINK_EDIT, "link")
+        is PlayAction.RemoveLink, is PlayAction.RemoveProjectionLink -> HistorySemantic(HistorySignificance.LINK_EDIT, "link_off")
+        is PlayAction.Combat -> when (val combat = action.action) {
+            CombatAction.Open -> HistorySemantic(HistorySignificance.COMBAT_AREA_CREATION, "swords")
+            is CombatAction.Close -> HistorySemantic(HistorySignificance.COMBAT_CLOSURE, "layers_clear")
+            is CombatAction.Declare -> HistorySemantic(HistorySignificance.COMBAT_MEMBERSHIP, "swords")
+            is CombatAction.Remove -> HistorySemantic(HistorySignificance.COMBAT_MEMBERSHIP, "remove_circle_outline")
+            is CombatAction.Place -> HistorySemantic(if (combat.expectedOccurrence == null ||
+                combat.expectedOccurrence.role != combat.destination.role) HistorySignificance.COMBAT_MEMBERSHIP
+                else HistorySignificance.COMBAT_LAYOUT, "open_with")
+        }
+        is PlayAction.Stack -> when (action.action) {
+            is StackAction.AddEffect -> HistorySemantic(HistorySignificance.STACK_ENTRY, "layers")
+            is StackAction.RemoveEffect -> HistorySemantic(HistorySignificance.STACK_REMOVAL, "layers_clear")
+            is StackAction.ReorderEffect -> HistorySemantic(HistorySignificance.STACK_LAYOUT, "open_with")
+        }
+        is PlayAction.MoveCard -> {
+            val from = containers.single { it.id == action.source.containerId }.zone
+            val to = containers.single { it.id == action.destination.containerId }.zone
+            when {
+                from == PlayZone.STACK && to == PlayZone.STACK ->
+                    HistorySemantic(HistorySignificance.STACK_LAYOUT, "open_with")
+                from == PlayZone.STACK -> HistorySemantic(HistorySignificance.STACK_REMOVAL, "layers")
+                to == PlayZone.STACK -> HistorySemantic(HistorySignificance.STACK_ENTRY, "layers")
+                else -> HistorySemantic(if (from == to) HistorySignificance.SAME_ZONE_PLACEMENT else HistorySignificance.CROSS_ZONE_MOVE,
+                    if (from == PlayZone.LIBRARY && to == PlayZone.HAND && action.source.edge == MoveSourceEdge.TOP)
+                        "download" else "open_with", "${action.source.containerId}/${action.destination.containerId}")
+            }
+        }
+    }
+
+    /** Compact prefix fold shared by authoritative append and provisional prediction. Never accepts client group IDs. */
+    fun append(previous: GameplayGroup?, nodeId: String, requestId: String, author: String, semantic: HistorySemantic): GameplayGroup {
+        val incoming = semantic.category
+        val context = previous?.let { group -> HistoryCategory.entries.single { it.key == group.category } }
+        val pending = context in setOf(HistoryCategory.T, HistoryCategory.F, HistoryCategory.R)
+        val joins = previous != null && previous.author == author && context != HistoryCategory.S && incoming != HistoryCategory.S && when (incoming) {
+            HistoryCategory.T -> previous.tapsAndPingsOnly
+            HistoryCategory.P, HistoryCategory.B -> true
+            HistoryCategory.F, HistoryCategory.R -> pending
+            else -> pending || when (context) {
+                HistoryCategory.C -> incoming in setOf(HistoryCategory.C, HistoryCategory.E)
+                HistoryCategory.M, HistoryCategory.H -> incoming == context && previous.key == semantic.key
+                HistoryCategory.E, HistoryCategory.K, HistoryCategory.L -> incoming == context
+                else -> false
+            }
+        }
+        val representative = HistoryRepresentative(nodeId, semantic)
+        if (!joins) return GameplayGroup(CommandIds.uuidV5(requestId, "group/0"), author, nodeId, nodeId,
+            (if (incoming in setOf(HistoryCategory.P, HistoryCategory.B)) HistoryCategory.O else incoming).key,
+            semantic.key, "1", incoming in setOf(HistoryCategory.T, HistoryCategory.P), representative)
+        val old = requireNotNull(previous)
+        val nextContext = when {
+            incoming in setOf(HistoryCategory.P, HistoryCategory.B) -> context!!
+            pending && semantic.significance.anchor -> incoming
+            context == HistoryCategory.O && incoming == HistoryCategory.T -> HistoryCategory.T
+            else -> context!!
+        }
+        return old.copy(lastNodeId = nodeId, category = nextContext.key,
+            key = if (pending && semantic.significance.anchor) semantic.key else old.key,
+            count = (old.count.toLong() + 1).toString(),
+            tapsAndPingsOnly = old.tapsAndPingsOnly && incoming in setOf(HistoryCategory.T, HistoryCategory.P),
+            representative = choose(old.representative, representative))
+    }
+
+    fun choose(first: HistoryRepresentative?, next: HistoryRepresentative): HistoryRepresentative {
+        if (first == null) return next
+        val a = first.semantic.significance; val b = next.semantic.significance
+        return if ((b.anchor && !a.anchor) || (b.anchor == a.anchor && b.rank < a.rank)) next else first
+    }
+}
diff --git a/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/LibraryActions.kt b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/LibraryActions.kt
new file mode 100644
index 0000000..bbe0f6b
--- /dev/null
+++ b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/LibraryActions.kt
@@ -0,0 +1,202 @@
+package org.asyncttwiz.protocol
+
+import kotlinx.serialization.Serializable
+
+@Serializable enum class ContentsSelection { TOP, BOTTOM, ALL }
+/** References, not a second containing zone. Only provisional displays may reconcile membership. */
+@Serializable data class ContentsDisplay(val id: String, val author: String, val containerId: String,
+    val selection: ContentsSelection, val requestedCount: Int, val reveal: Boolean, val cardIds: List<String>) {
+    fun facesVisibleTo(accountId: String) = reveal || author == accountId
+}
+@Serializable data class LibraryOrderChange(val containerId: String, val from: List<String>, val to: List<String>)
+@Serializable data class ContentsDisplayChange(val from: ContentsDisplay? = null, val to: ContentsDisplay? = null)
+
+/** Shared processing helpers called only by GameplayRules, never an independent client engine. */
+object LibraryRules {
+    fun slice(cards: List<String>, selection: ContentsSelection, count: Int): List<String> {
+        require(count >= 0)
+        return when (selection) {
+            ContentsSelection.TOP -> cards.take(count)
+            ContentsSelection.BOTTOM -> cards.takeLast(count)
+            ContentsSelection.ALL -> cards.toList()
+        }
+    }
+
+    internal fun change(state: PlayState, actor: String, command: GameCommand, action: PlayAction): GameplayChange {
+        val board = state.board
+        return when (action) {
+            is PlayAction.ShuffleLibrary -> {
+                val source = board.containers.singleOrNull { it.id == action.containerId && it.zone == PlayZone.LIBRARY }
+                    ?: return GameplayChange(reason = "missingReference")
+                val order = RandomV1.shuffle(source.cards, action.seed, action.algorithm)
+                // Even a coincidentally identical permutation retains this fresh random invocation.
+                GameplayRules.record(state, actor, command, board.copy(containers = board.containers.map {
+                    if (it.id == source.id) it.copy(cards = order) else it
+                }), GameplayTransition(libraryOrder = LibraryOrderChange(source.id, source.cards, order)))
+            }
+            is PlayAction.ShowContents -> {
+                val source = board.containers.singleOrNull { it.id == action.containerId }
+                    ?: return GameplayChange(reason = "missingReference")
+                if (source.zone !in specialZones || source.zone != PlayZone.LIBRARY && action.selection != ContentsSelection.ALL)
+                    return GameplayChange(reason = "inapplicable")
+                val members = slice(source.cards, action.selection, action.count)
+                // ALL is orderless, including in history: no hidden Library indices in a full browser.
+                val display = ContentsDisplay(CommandIds.uuidV5(command.requestId, "contents/0"), actor, source.id,
+                    action.selection, action.count, action.reveal,
+                    if (action.selection == ContentsSelection.ALL) members.sorted() else members)
+                GameplayRules.record(state, actor, command,
+                    board.copy(contentsDisplays = board.contentsDisplays + display),
+                    GameplayTransition(contents = ContentsDisplayChange(to = display)))
+            }
+            is PlayAction.DismissContents -> {
+                val display = board.contentsDisplays.singleOrNull { it.id == action.displayId } ?: return GameplayChange(state)
+                GameplayRules.record(state, actor, command,
+                    board.copy(contentsDisplays = board.contentsDisplays.filterNot { it.id == display.id }),
+                    GameplayTransition(contents = ContentsDisplayChange(from = display)))
+            }
+            else -> error("Not a Library action")
+        }
+    }
+
+    private val specialZones = setOf(PlayZone.LIBRARY, PlayZone.GRAVEYARD, PlayZone.EXILE)
+
+    /** Early I13 seam: concrete Hand/special-container moves. Board/Stack and token cleanup stay I13/I19. */
+    internal fun move(state: PlayState, actor: String, command: GameCommand, action: PlayAction.MoveCard): GameplayChange {
+        fun reject() = GameplayChange(reason = "inapplicable")
+        val board = state.board
+        val card = board.cards.singleOrNull { it.id == action.cardId } ?: return GameplayChange(reason = "missingReference")
+        val source = board.containers.singleOrNull { it.id == action.source.containerId } ?: return reject()
+        val destination = board.containers.singleOrNull { it.id == action.destination.containerId } ?: return reject()
+        if (source.zone !in specialZones + PlayZone.HAND || destination.zone !in specialZones + PlayZone.HAND ||
+            card.token || card.containerId != source.id || card.id !in source.cards ||
+            card.placement != action.source.placement || action.destination.position != null ||
+            action.destination.pileId != null || action.expectedStackDigest != null) return reject()
+        if (action.source.edge != MoveSourceEdge.MEMBER && source.zone != PlayZone.LIBRARY) return reject()
+        if (action.source.edge == MoveSourceEdge.TOP && source.cards.firstOrNull() != card.id ||
+            action.source.edge == MoveSourceEdge.BOTTOM && source.cards.lastOrNull() != card.id) return reject()
+        val slice = action.source.bottomSlice
+        if (slice.isNotEmpty() && (source.zone != PlayZone.LIBRARY || slice.first() != card.id ||
+                source.cards.takeLast(slice.size) != slice)) return reject()
+        val target = action.destination
+        val remaining = destination.cards.filterNot { it == card.id }
+        val index = if (destination.zone == PlayZone.LIBRARY) when (target.insertion) {
+            MoveInsertion.TOP -> 0
+            MoveInsertion.BOTTOM -> remaining.size
+            MoveInsertion.GAP -> {
+                if (card.id in target.pendingIds || target.afterId in target.pendingIds || target.beforeId in target.pendingIds)
+                    return reject()
+                // Still-pending members of this invocation do not invalidate its normalized gap.
+                val reduced = remaining.filterNot { it in target.pendingIds }
+                val left = target.afterId?.let { reduced.indexOf(it).takeIf { index -> index >= 0 } ?: return reject() } ?: -1
+                val right = target.beforeId?.let { reduced.indexOf(it).takeIf { index -> index >= 0 } ?: return reject() } ?: reduced.size
+                if (right != left + 1) return reject()
+                target.afterId?.let { remaining.indexOf(it) + 1 } ?: 0
+            }
+            else -> return reject()
+        } else {
+            if (target.insertion != MoveInsertion.UNORDERED) return reject()
+            remaining.size
+        }
+        val order = remaining.toMutableList().apply { add(index, card.id) }
+        val entering = source.id != destination.id
+        val reset = entering && destination.zone in specialZones
+        val defaultCorner = state.definitions.singleOrNull { it.digest == card.definition }?.definition?.faces
+            ?.singleOrNull { it.faceId == card.faceId }?.corner.orEmpty()
+        val updated = card.copy(containerId = destination.id, placement = null,
+            corner = if (reset) defaultCorner else card.corner, counters = if (reset) emptyMap() else card.counters)
+        if (source.id == destination.id && destination.zone != PlayZone.LIBRARY ||
+            source.id == destination.id && order == source.cards && updated == card) return GameplayChange(state)
+        val fields = buildList {
+            if (updated.corner != card.corner) add(GameplayFieldChange(card.id, GameplayField.CORNER, card.corner, updated.corner))
+            for (color in CounterColor.entries) if (reset && color in card.counters)
+                add(GameplayFieldChange(card.id, GameplayField.COUNTER, card.counters.getValue(color), null, color))
+        }
+        fun location(container: PlayContainer, cards: List<String>): CardLocation {
+            val at = cards.indexOf(card.id)
+            return if (container.zone == PlayZone.LIBRARY) CardLocation(container.id,
+                afterId = cards.getOrNull(at - 1), beforeId = cards.getOrNull(at + 1)) else CardLocation(container.id)
+        }
+        val next = board.copy(cards = board.cards.map { if (it.id == card.id) updated else it },
+            containers = board.containers.map {
+                when (it.id) {
+                    destination.id -> it.copy(cards = order)
+                    source.id -> it.copy(cards = it.cards.filterNot { id -> id == card.id })
+                    else -> it
+                }
+            })
+        return GameplayRules.record(state, actor, command, next, GameplayTransition(fields,
+            GameplayMoveChange(card.id, location(source, source.cards), location(destination, order))))
+    }
+}
+
+/** Captured plans are immutable request intent; callers enqueue each constituent without awaiting results. */
+object LibraryActions {
+    fun draw(board: BoardState, libraryId: String, handId: String, count: Int): List<PlayAction.MoveCard> {
+        require(count >= 0)
+        val library = board.containers.single { it.id == libraryId && it.zone == PlayZone.LIBRARY }
+        require(board.containers.any { it.id == handId && it.zone == PlayZone.HAND && it.accountId == library.accountId })
+        return library.cards.take(count).map { PlayAction.MoveCard(it, MoveSource(libraryId, edge = MoveSourceEdge.TOP),
+            MoveDestination(handId, MoveInsertion.UNORDERED)) }
+    }
+
+    fun moveSlice(board: BoardState, libraryId: String, selection: ContentsSelection, count: Int,
+        destination: MoveDestination): List<PlayAction.MoveCard> {
+        val library = board.containers.single { it.id == libraryId && it.zone == PlayZone.LIBRARY }
+        val ids = LibraryRules.slice(library.cards, selection, count)
+        return moveCaptured(board, ids, destination).mapIndexed { index, action -> action.copy(source = action.source.copy(
+            edge = if (selection == ContentsSelection.TOP) MoveSourceEdge.TOP else MoveSourceEdge.MEMBER,
+            bottomSlice = if (selection == ContentsSelection.BOTTOM) ids.drop(index) else emptyList())) }
+    }
+
+    fun moveCaptured(board: BoardState, capturedIds: List<String>, destination: MoveDestination): List<PlayAction.MoveCard> {
+        val ids = capturedIds.distinct()
+        val cards = ids.map { id -> board.cards.single { it.id == id } }
+        val target = board.containers.single { it.id == destination.containerId }
+        val reduced = target.cards.filterNot { it in ids }
+        if (target.zone == PlayZone.LIBRARY) require(destination.insertion in setOf(MoveInsertion.TOP, MoveInsertion.BOTTOM, MoveInsertion.GAP))
+        else require(target.zone in setOf(PlayZone.HAND, PlayZone.GRAVEYARD, PlayZone.EXILE) && destination.insertion == MoveInsertion.UNORDERED)
+        var after = when (destination.insertion) {
+            MoveInsertion.BOTTOM -> reduced.lastOrNull()
+            MoveInsertion.GAP -> destination.afterId
+            else -> null
+        }
+        val before = when (destination.insertion) {
+            MoveInsertion.TOP -> reduced.firstOrNull()
+            MoveInsertion.GAP -> destination.beforeId
+            else -> null
+        }
+        if (destination.insertion == MoveInsertion.GAP) {
+            val left = after?.let { reduced.indexOf(it).also { index -> require(index >= 0) } } ?: -1
+            val right = before?.let { reduced.indexOf(it).also { index -> require(index >= 0) } } ?: reduced.size
+            require(right == left + 1)
+        }
+        if (cards.all { it.containerId == target.id } && target.zone == PlayZone.LIBRARY) {
+            val at = after?.let { reduced.indexOf(it) + 1 } ?: 0
+            val final = reduced.toMutableList().apply { addAll(at, ids) }
+            if (final == target.cards) return emptyList()
+        }
+        return cards.mapIndexed { index, card ->
+            val move = PlayAction.MoveCard(card.id, MoveSource(card.containerId, card.placement),
+                if (target.zone == PlayZone.LIBRARY) destination.copy(insertion = MoveInsertion.GAP,
+                    afterId = after, beforeId = before, pendingIds = ids.drop(index + 1)) else destination)
+            // I19's token-removal processor must never turn a disappearing member into an anchor.
+            if (!card.token || target.zone !in setOf(PlayZone.LIBRARY, PlayZone.GRAVEYARD, PlayZone.EXILE)) after = card.id
+            move
+        }
+    }
+
+    data class Mulligan(val libraryId: String, val handId: String, val handIds: List<String>,
+        val preReturnSize: Int, val drawCount: Int, val seed: String, val returns: List<PlayAction.MoveCard>) {
+        fun prefix(): List<PlayAction> = returns + PlayAction.ShuffleLibrary(libraryId, seed)
+    }
+    fun mulligan(board: BoardState, libraryId: String, handId: String, displayedHand: List<String>, seed: String,
+        count: Int = 7, minusOne: Boolean = false): Mulligan {
+        require(count >= 0); RandomV1.decodeSeed(seed)
+        val library = board.containers.single { it.id == libraryId && it.zone == PlayZone.LIBRARY }
+        val hand = board.containers.single { it.id == handId && it.zone == PlayZone.HAND && it.accountId == library.accountId }
+        require(displayedHand.distinct().size == displayedHand.size && displayedHand.toSet() == hand.cards.toSet())
+        return Mulligan(libraryId, handId, displayedHand.toList(), displayedHand.size,
+            if (minusOne) (displayedHand.size - 1).coerceAtLeast(0) else count, seed,
+            moveCaptured(board, displayedHand, MoveDestination(libraryId, MoveInsertion.TOP)))
+    }
+}
diff --git a/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/ManualEdits.kt b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/ManualEdits.kt
new file mode 100644
index 0000000..ef61c00
--- /dev/null
+++ b/protocol/src/commonMain/kotlin/org/asyncttwiz/protocol/ManualEdits.kt
@@ -0,0 +1,180 @@
+package org.asyncttwiz.protocol
+
+import kotlinx.serialization.Serializable
+
+@Serializable enum class CornerPart { WHOLE, LEFT, RIGHT, BOTH }
+@Serializable enum class CounterTarget { CARD, PLAYER }
+
+/** Text first. Signed decimal integers use the existing life tool's checked 64-bit arithmetic. */
+object ManualText {
+    private val integer = Regex("[+-]?[0-9]+")
+    fun number(text: String): Long? = text.trim().takeIf { integer.matches(it) }?.toLongOrNull()
+    fun add(text: String, delta: Long): String? {
+        val from = number(text) ?: return null
+        val sum = from + delta
+        return if ((from xor sum) and (delta xor sum) < 0) null else sum.toString()
+    }
+    fun corner(text: String, part: CornerPart, delta: Int): String? {
+        if (delta != 1 && delta != -1) return null
+        val value = text.trim()
+        if (part == CornerPart.WHOLE) return add(value, delta.toLong())
+        val pair = value.split('/')
+        if (pair.size != 2 || pair.any { number(it) == null || it != it.trim() }) return null
+        val left = if (part != CornerPart.RIGHT) add(pair[0], delta.toLong()) ?: return null else pair[0]
+        val right = if (part != CornerPart.LEFT) add(pair[1], delta.toLong()) ?: return null else pair[1]
+        return "$left/$right"
+    }
+    fun playerCounterText(value: String?): String = value.orEmpty()
+    fun cardCounterText(value: String?): String = value?.takeIf { it.isNotEmpty() } ?: "–"
+    fun playerRowVisible(counters: Map<CounterColor, String>): Boolean = counters.values.any {
+        val text = it.trim()
+        text.isNotEmpty() && !(integer.matches(text) && text.removePrefix("+").removePrefix("-").all { c -> c == '0' })
+    }
+}
+
+/** A permission calculation, not evidence of a logged inspection or a cache-based disclosure grant. */
+object ManualDisclosure {
+    fun ownRegion(state: PlayState, card: PlayCard, viewer: String): Boolean =
+        state.board.containers.singleOrNull { it.id == card.containerId }?.accountId == viewer
+
+    fun permittedFaces(state: PlayState, card: PlayCard, viewer: String, inspecting: Boolean): List<DefinitionFace> {
+        val faces = state.definitions.singleOrNull { it.digest == card.definition }?.definition?.faces.orEmpty()
+        return if (inspecting && ownRegion(state, card, viewer)) faces
+        else if (!card.covered) faces.filter { it.faceId == card.faceId } else emptyList()
+    }
+}
+
+/** Called only through GameplayRules, after its scope/access/wire checks. No second authoritative path. */
+object ManualEditRules {
+    fun valid(action: PlayAction.Manual): Boolean = when (action) {
+        is PlayAction.SetCorner -> DeckValidation.uuid(action.cardId) && DeckValidation.text(action.value.trim())
+        is PlayAction.AdjustCorner -> DeckValidation.uuid(action.cardId) && action.delta in listOf(-1, 1)
+        is PlayAction.ResetCorner -> DeckValidation.uuid(action.cardId)
+        is PlayAction.SetCounter -> DeckValidation.uuid(action.targetId) && DeckValidation.text(action.value.trim())
+        is PlayAction.AdjustCounter -> DeckValidation.uuid(action.targetId) && ManualText.number(action.delta) != null &&
+            action.delta == action.delta.trim()
+        is PlayAction.SetNote -> DeckValidation.uuid(action.cardId) && DeckValidation.text(action.value.trim())
+        is PlayAction.SetOwner -> DeckValidation.uuid(action.cardId) && DeckValidation.uuid(action.accountId)
+        is PlayAction.SetFace -> DeckValidation.uuid(action.cardId) && DeckValidation.uuid(action.faceId)
+        is PlayAction.SetCovered -> DeckValidation.uuid(action.cardId)
+        is PlayAction.InspectFace -> listOf(action.cardId, action.faceId, action.containerId).all(DeckValidation::uuid)
+    }
+
+    internal fun change(state: PlayState, actor: String, command: GameCommand, action: PlayAction.Manual): GameplayChange {
+        val transition = transition(state, actor, action) ?: return GameplayChange(reason = "inapplicable")
+        if (transition.fields.isEmpty() && transition.disclosures.isEmpty()) return GameplayChange(state)
+        return GameplayRules.record(state, actor, command, apply(state.board, transition.fields), transition)
+    }
+
+    private fun transition(state: PlayState, actor: String, action: PlayAction.Manual): GameplayTransition? {
+        val board = state.board
+        fun field(id: String, type: GameplayField, from: String?, to: String?, color: CounterColor? = null,
+            reads: List<GameplayRead> = emptyList(), disclosures: List<GameplayDisclosure> = emptyList()) =
+            GameplayTransition(if (from == to) emptyList() else listOf(GameplayFieldChange(id, type, from, to, color)),
+                reads = reads, disclosures = disclosures)
+        if (action is PlayAction.SetCounter || action is PlayAction.AdjustCounter) {
+            val target = if (action is PlayAction.SetCounter) action.target else (action as PlayAction.AdjustCounter).target
+            val id = if (action is PlayAction.SetCounter) action.targetId else (action as PlayAction.AdjustCounter).targetId
+            val color = if (action is PlayAction.SetCounter) action.color else (action as PlayAction.AdjustCounter).color
+            val counters = when (target) {
+                CounterTarget.CARD -> board.cards.singleOrNull { it.id == id }?.counters
+                CounterTarget.PLAYER -> board.players.singleOrNull { it.accountId == id }?.counters
+            } ?: return null
+            val from = counters[color]
+            val to = if (action is PlayAction.SetCounter) action.value.trim().ifEmpty { null }
+                else ManualText.add(from ?: "0", (action as PlayAction.AdjustCounter).delta.toLong()) ?: return null
+            return field(id, if (target == CounterTarget.CARD) GameplayField.COUNTER else GameplayField.PLAYER_COUNTER,
+                from, to, color)
+        }
+        val id = when (action) {
+            is PlayAction.SetCorner -> action.cardId
+            is PlayAction.AdjustCorner -> action.cardId
+            is PlayAction.ResetCorner -> action.cardId
+            is PlayAction.SetNote -> action.cardId
+            is PlayAction.SetOwner -> action.cardId
+            is PlayAction.SetFace -> action.cardId
+            is PlayAction.SetCovered -> action.cardId
+            is PlayAction.InspectFace -> action.cardId
+            else -> return null
+        }
+        val card = board.cards.singleOrNull { it.id == id } ?: return null
+        val faces = state.definitions.singleOrNull { it.digest == card.definition }?.definition?.faces.orEmpty()
+        fun exposure(face: String, viewers: List<String>) = GameplayDisclosure(id, face, card.containerId, viewers.sorted())
+        return when (action) {
+            is PlayAction.SetCorner -> field(id, GameplayField.CORNER, card.corner, action.value.trim())
+            is PlayAction.AdjustCorner -> field(id, GameplayField.CORNER, card.corner,
+                ManualText.corner(card.corner, action.part, action.delta) ?: return null)
+            is PlayAction.ResetCorner -> field(id, GameplayField.CORNER, card.corner,
+                faces.singleOrNull { it.faceId == card.faceId }?.corner.orEmpty(),
+                reads = listOf(GameplayRead(id, GameplayField.FACE, card.faceId)))
+            is PlayAction.SetNote -> field(id, GameplayField.NOTE, card.note, action.value.trim())
+            is PlayAction.SetOwner -> if (board.players.none { it.accountId == action.accountId }) null
+                else field(id, GameplayField.OWNER, card.owner, action.accountId)
+            is PlayAction.SetFace -> if (faces.none { it.faceId == action.faceId }) null
+                else field(id, GameplayField.FACE, card.faceId, action.faceId,
+                    reads = listOf(GameplayRead(id, GameplayField.COVERED, card.covered.toString())),
+                    disclosures = if (!card.covered && card.faceId != action.faceId)
+                        listOf(exposure(action.faceId, board.players.map { it.accountId })) else emptyList())
+            is PlayAction.SetCovered -> field(id, GameplayField.COVERED, card.covered.toString(), action.covered.toString(),
+                reads = if (!action.covered) listOf(GameplayRead(id, GameplayField.FACE, card.faceId)) else emptyList(),
+                disclosures = if (card.covered && !action.covered)
+                    listOf(exposure(card.faceId, board.players.map { it.accountId })) else emptyList())
+            is PlayAction.InspectFace -> if (card.containerId != action.containerId || faces.none { it.faceId == action.faceId }) null
+                else GameplayTransition(reads = listOf(GameplayRead(id, GameplayField.CONTAINER, card.containerId)),
+                    disclosures = listOf(exposure(action.faceId, listOf(actor))))
+            else -> null
+        }
+    }
+
+    /** Replay applies accepted tuples, not a fresh Reset/default/arithmetic operation. */
+    internal fun replay(state: PlayState, mutation: GameplayMutation, command: GameCommand): GameplayChange {
+        val transition = mutation.transition
+        fun value(id: String, field: GameplayField, color: CounterColor? = null): String? {
+            val card = state.board.cards.singleOrNull { it.id == id }
+            return when (field) {
+                GameplayField.CORNER -> card?.corner
+                GameplayField.COUNTER -> card?.counters?.get(color)
+                GameplayField.PLAYER_COUNTER -> state.board.players.singleOrNull { it.accountId == id }?.counters?.get(color)
+                GameplayField.NOTE -> card?.note
+                GameplayField.OWNER -> card?.owner
+                GameplayField.FACE -> card?.faceId
+                GameplayField.COVERED -> card?.covered?.toString()
+                GameplayField.CONTAINER -> card?.containerId
+                else -> null
+            }
+        }
+        val targets = state.board.cards.map { it.id } + state.board.players.map { it.accountId }
+        if (!GameWire.valid(command) || mutation.author !in state.board.players.map { it.accountId } ||
+            transition.movement != null || transition.tokens.isNotEmpty() || transition.links.isNotEmpty() ||
+            transition.libraryOrder != null || transition.contents != null || transition.random != null ||
+            transition.annotation != null || transition.combatStack != null ||
+            transition.cloneRead != null || transition.tokenMoveRead != null || transition.fields.any { it.targetId !in targets ||
+                value(it.targetId, it.field, it.color) != it.from } ||
+            transition.reads.any { value(it.targetId, it.field) != it.value } ||
+            transition.disclosures.any { disclosure -> state.board.cards.none { it.id == disclosure.cardId &&
+                it.containerId == disclosure.containerId } }) return GameplayChange(reason = "replayBlocked")
+        return GameplayRules.record(state, mutation.author, command, apply(state.board, transition.fields), transition)
+    }
+
+    private fun apply(board: BoardState, fields: List<GameplayFieldChange>): BoardState {
+        var next = board
+        for (field in fields) {
+            fun counters(values: Map<CounterColor, String>): Map<CounterColor, String> =
+                if (field.to == null) values - field.color!! else values + (field.color!! to field.to)
+            next = if (field.field == GameplayField.PLAYER_COUNTER) next.copy(players = next.players.map {
+                if (it.accountId == field.targetId) it.copy(counters = counters(it.counters)) else it
+            }) else next.copy(cards = next.cards.map {
+                if (it.id != field.targetId) it else when (field.field) {
+                    GameplayField.CORNER -> it.copy(corner = field.to!!)
+                    GameplayField.COUNTER -> it.copy(counters = counters(it.counters))
+                    GameplayField.NOTE -> it.copy(note = field.to!!)
+                    GameplayField.OWNER -> it.copy(owner = field.to!!)
+                    GameplayField.FACE -> it.copy(faceId = field.to!!)
+                    GameplayField.COVERED -> it.copy(covered = field.to!!.toBooleanStrict())
+                    else -> error("Not a manual card field")
+                }
+            })
+        }
+        return next
+    }
+}
